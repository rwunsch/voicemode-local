# Wait until the Docker STT/TTS backends answer, or time out. Returns 0/1.
# Probe Kokoro at /health (universal across versions) NOT /v1/models — the GPU
# build (kokoro-fastapi v0.2.x) has no /v1/models endpoint though TTS works fine.
wait_for_backends() {
    local timeout="${1:-180}" i
    for i in $(seq 1 "$timeout"); do
        if curl -sf --max-time 2 "http://127.0.0.1:8880/health" >/dev/null 2>&1 \
           && curl -sf --max-time 2 "http://127.0.0.1:9000/docs" >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# compute [gpu|hybrid|cpu] [whisper-model]
#   no arg  -> show current compute mode, whisper model, GPU capability, images
#   gpu     -> Whisper + Kokoro both on CUDA          (verifies GPU first)
#   hybrid  -> Kokoro on GPU, Whisper on CPU          (recommended w/ a GPU)
#   cpu     -> both on CPU (Kokoro core-capped)
# NOTE: switching recreates the Docker containers, which interrupts any in-flight
# voice exchange. It does NOT change routing, so no Claude Code restart is needed.
cmd_compute() {
    local action="${1:-show}" model="${2:-}"
    local cur_mode cur_model
    cur_mode="$(vm_read_config COMPUTE_MODE cpu)"
    cur_model="$(vm_read_config WHISPER_MODEL "$(vm_recommended_whisper_model "$cur_mode")")"

    case "$action" in
        show|"")
            echo "=== VoiceMode compute mode ==="
            echo "  Current mode:   $cur_mode"
            echo "  Whisper model:  $cur_model"
            if vm_detect_gpu; then
                ok "GPU available — $VM_GPU_REASON"
                [ "$cur_mode" = cpu ] && echo "    Recommended:  voicemode-switch compute hybrid  (Kokoro GPU + Whisper CPU)"
            else
                warn "GPU not available — $VM_GPU_REASON"
                echo "    Staying on CPU is the right call here."
            fi
            echo ""
            echo "  Images in use for '$cur_mode' mode:"
            case "$cur_mode" in
                gpu)
                    echo "    Kokoro:  ${KOKORO_GPU_IMAGE:-ghcr.io/remsky/kokoro-fastapi-gpu:v0.2.0} (GPU)"
                    echo "    Whisper: onerahmet/openai-whisper-asr-webservice:latest-gpu (GPU, model: $cur_model)" ;;
                hybrid)
                    echo "    Kokoro:  ${KOKORO_GPU_IMAGE:-ghcr.io/remsky/kokoro-fastapi-gpu:v0.2.0} (GPU)"
                    echo "    Whisper: onerahmet/openai-whisper-asr-webservice:latest (CPU, model: $cur_model)" ;;
                *)
                    echo "    Kokoro:  ${KOKORO_IMAGE:-ghcr.io/remsky/kokoro-fastapi-cpu:latest} (CPU-capped at ${KOKORO_CPUS:-6} cores)"
                    echo "    Whisper: onerahmet/openai-whisper-asr-webservice:latest (CPU, model: $cur_model)" ;;
            esac
            echo ""
            echo "  Modes: cpu | gpu | hybrid   (hybrid = Kokoro GPU + Whisper CPU, recommended with a GPU)"
            return 0 ;;
        gpu|hybrid)
            local target="$action" desc
            [ "$target" = hybrid ] && desc="Kokoro on GPU, Whisper on CPU" || desc="Whisper + Kokoro on GPU"
            echo "=== Switching compute mode -> ${target} ($desc) ==="
            if ! vm_detect_gpu; then
                fail "Cannot enable ${target}: $VM_GPU_REASON"
                echo "  Fix the above (driver / nvidia-container-toolkit) then retry."
                return 1
            fi
            ok "$VM_GPU_REASON"
            warn "This recreates containers and pulls any missing image (CUDA images are large"
            warn "on first use). Any active voice exchange will be interrupted."
            vm_write_config COMPUTE_MODE "$target"
            vm_write_config WHISPER_MODEL "${model:-$(vm_recommended_whisper_model "$target")}"
            echo "  Recreating containers (${target})..."
            # First GPU start is slow: CUDA init + kokoro build + (for full GPU) the
            # Whisper model download can take several minutes, so allow a generous
            # window before concluding failure (avoids a false rollback).
            if docker_compose_cmd up -d 2>&1 | sed 's/^/    /' && wait_for_backends 600; then
                ok "${target} mode active. Verifying the GPU is actually in use..."
                sleep 2
                if nvidia-smi --query-compute-apps=process_name --format=csv,noheader 2>/dev/null | grep -qiE 'python|kokoro|whisper'; then
                    ok "Confirmed: a voice service is running on the GPU."
                else
                    warn "Containers are up but no GPU compute process is visible yet"
                    warn "(it may appear on first request). Check: nvidia-smi"
                fi
                cmd_health || true
            else
                fail "${target} containers did not become healthy — rolling back to CPU."
                vm_write_config COMPUTE_MODE cpu
                vm_write_config WHISPER_MODEL "$(vm_recommended_whisper_model cpu)"
                docker_compose_cmd up -d 2>&1 | sed 's/^/    /'
                wait_for_backends 120 && ok "Rolled back to CPU." || fail "CPU rollback also unhealthy — check 'voicemode-switch status'."
                return 1
            fi
            return 0 ;;
        cpu)
            echo "=== Switching compute mode -> CPU ==="
            warn "This recreates the Whisper+Kokoro containers; active exchanges will be interrupted."
            vm_write_config COMPUTE_MODE cpu
            vm_write_config WHISPER_MODEL "${model:-$(vm_recommended_whisper_model cpu)}"
            echo "  Recreating containers with CPU images..."
            if docker_compose_cmd up -d 2>&1 | sed 's/^/    /' && wait_for_backends 180; then
                ok "CPU mode active (Kokoro capped at ${KOKORO_CPUS:-6} cores)."
                cmd_health || true
            else
                fail "Containers did not become healthy — check 'voicemode-switch status'."
                return 1
            fi
            return 0 ;;
        *)
            fail "Unknown compute action: $action (use: gpu | hybrid | cpu | show)"
            return 1 ;;
    esac
}

case "${1:-}" in
    local)     cmd_local ;;
    localonly) cmd_localonly ;;
    openai)    cmd_openai ;;
    hybrid)    cmd_hybrid ;;
    piper)     cmd_piper ;;
    status)    cmd_status ;;
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    ensure) cmd_ensure "${2:-}" ;;
    health) cmd_health ;;
    compute) cmd_compute "${2:-}" "${3:-}" ;;
    queue)
        # Upstream's conch queue (8.8.0 epic VM-1610) replaced our voice_queue.py.
        # `voicemode conch status` shows the floor holder + the FIFO waiter list.
        VM="$SCRIPT_DIR/.venv/bin/voicemode"
        [ -x "$VM" ] || VM="voicemode"
        "$VM" conch status "${@:2}"
        ;;
    floor)
        VM="$SCRIPT_DIR/.venv/bin/voicemode"
        [ -x "$VM" ] || VM="voicemode"
        case "${2:-status}" in
            reset)   "$VM" conch release ;;
            status|"") "$VM" conch status ;;
            give)    shift 2; "$VM" conch give "$@" ;;
            *) echo "usage: voicemode-switch floor [status|reset|give <session>]"; exit 1 ;;
        esac
        ;;
    conch)
        # Passthrough to upstream's conch CLI for anything we don't wrap
        # (bump, wait, and any future subcommand).
        VM="$SCRIPT_DIR/.venv/bin/voicemode"
        [ -x "$VM" ] || VM="voicemode"
        shift; "$VM" conch "$@"
        ;;
    audio-token)
        # Toggle the cross-process audio token (VOICEMODE_AUDIO_TOKEN_ENABLED) in
        # voicemode.env, which voice-mode folds into its env at startup. Takes
        # effect when each session's voice-mode restarts (/mcp reconnect).
        ENVF="$HOME/.voicemode/voicemode.env"
        PYBIN="$SCRIPT_DIR/.venv/bin/python"; [ -x "$PYBIN" ] || PYBIN="python3"
        case "${2:-status}" in
            on|off)
                val=$([ "${2}" = "on" ] && echo true || echo false)
                "$PYBIN" - "$ENVF" "$val" <<'PY'
import sys, re, pathlib
f=pathlib.Path(sys.argv[1]); val=sys.argv[2]
txt=f.read_text() if f.exists() else ""
line=f"VOICEMODE_AUDIO_TOKEN_ENABLED={val}"
if re.search(r'^VOICEMODE_AUDIO_TOKEN_ENABLED=', txt, re.M):
    txt=re.sub(r'^VOICEMODE_AUDIO_TOKEN_ENABLED=.*$', line, txt, flags=re.M)
else:
    txt=txt.rstrip('\n')+'\n'+line+'\n'
f.write_text(txt)
print(f"set {line} in {f}")
PY
                echo "Reconnect voice-mode in each session (/mcp) for it to take effect."
                echo "Rollback anytime: voicemode-switch audio-token off  (then reconnect)."
                ;;
            status|"")
                cur=$(grep -E '^VOICEMODE_AUDIO_TOKEN_ENABLED=' "$ENVF" 2>/dev/null | tail -1 | cut -d= -f2)
                echo "audio token (voicemode.env): ${cur:-false (default)}"
                echo "live floor holder (upstream conch):"
                VM="$SCRIPT_DIR/.venv/bin/voicemode"; [ -x "$VM" ] || VM="voicemode"
                "$VM" conch status 2>/dev/null | sed 's/^/  /'
                ;;
            *) echo "usage: voicemode-switch audio-token [on|off|status]"; exit 1 ;;
        esac
        ;;
    queue-log)
        # Our voice_queue.py wrote ~/.voicemode/logs/queue.log; upstream's conch
        # logs through voice-mode itself. Tail whichever exists.
        LOG="$HOME/.voicemode/logs/voicemode.log"
        [ -f "$LOG" ] || LOG="$HOME/.voicemode/logs/queue.log"
        if [ ! -f "$LOG" ]; then
            warn "No voicemode log found under $HOME/.voicemode/logs/"
            exit 0
        fi
        echo "Tailing $LOG for conch activity (Ctrl-C to stop)..."
        tail -n 40 -f "$LOG" | grep --line-buffered -iE "conch|queue|floor|grant" || true
        ;;
    sysaudio)
        PYBIN="$SCRIPT_DIR/.venv/bin/python"
        [ -x "$PYBIN" ] || PYBIN="python3"
        PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYBIN" -m voicemode_sysaudio "${2:-status}"
        ;;
    test-tts)
        shift
        python3 "$SCRIPT_DIR/voicemode-test-tts.py" "$@"
        ;;
    *)
        echo "Usage: voicemode-switch <command>"
        echo ""
        echo "Commands:"
        echo "  local     Local Kokoro+Piper TTS & Whisper STT, OpenAI last resort (recommended)"
        echo "  localonly Local Kokoro+Piper+Whisper only, no cloud (fails loud if down)"
        echo "  openai    Use OpenAI for both STT and TTS (cloud only)"
        echo "  hybrid    Local Kokoro+Piper TTS + OpenAI STT"
        echo "  piper     Piper TTS primary (German etc.), Kokoro+OpenAI behind"
        echo "  status   Show current config and service health"
        echo "  start    Start local Docker services + proxy"
        echo "  stop     Stop local services"
        echo "  ensure   Start (detached) only the proxies the current config needs"
        echo "  health   Probe configured local proxies (exit 0 iff all up)"
        echo "  compute  Show or switch run-mode: compute [gpu|hybrid|cpu] [whisper-model]"
        echo "           (hybrid = Kokoro GPU + Whisper CPU — recommended when a GPU exists)"
        echo "  test-tts Show which engine serves each voice (fallback demo)"
        echo "  queue    Show voice session queue (upstream conch: holder + waiters)"
        echo "  conch    Passthrough to the upstream conch CLI (bump, wait, ...)"
        echo "  floor    Show floor state (status) or clear a wedged floor: floor [status|reset]"
        echo "  audio-token  Toggle cross-process audio device exclusivity: audio-token [on|off|status]"
        echo "  queue-log Tail the per-session queue event log (debug)"
        echo "  sysaudio  Fold system output into voice input: on|off|status|setup|teardown"
        echo ""
        echo "After switching modes, restart Claude Code for changes to take effect."
        ;;
esac
