#!/usr/bin/env bash
#
# voicemode-switch — Switch VoiceMode between local and OpenAI backends
#
# Usage:
#   voicemode-switch local    # Use local Whisper STT + Kokoro TTS
#   voicemode-switch openai   # Use OpenAI for both STT and TTS
#   voicemode-switch hybrid   # Use local Kokoro TTS + OpenAI Whisper STT
#   voicemode-switch status   # Show current config and service health
#   voicemode-switch start    # Start local services (Docker + proxy)
#   voicemode-switch stop     # Stop local services
#   voicemode-switch queue    # Show voice session queue (floor holder + waiters)
#
# After switching, restart Claude Code for changes to take effect.

set -euo pipefail

CLAUDE_JSON="$HOME/.claude.json"
# Resolve symlinks to find the real project directory
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Python from the project venv. Proxies that import heavy deps (piper-tts,
# kokoro-onnx) MUST run under this, NOT the ambient `python3`. When a proxy is
# auto-started from Claude Code's MCP environment, bare `python3` resolves to a
# system/linuxbrew interpreter WITHOUT those packages — piper-proxy then falls
# back to spawning the piper CLI, which reloads its 100MB+ model on every
# request (~7-34s), blowing past voice-mode's client timeout and silently
# routing German to OpenAI (English voice). The venv python enables the warm
# in-process path (~0.5s/request).
VENV_PY="$SCRIPT_DIR/.venv/bin/python"
[ -x "$VENV_PY" ] || VENV_PY="python3"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
GPU_COMPOSE_FILE="$SCRIPT_DIR/docker-compose.gpu.yml"
HYBRID_COMPOSE_FILE="$SCRIPT_DIR/docker-compose.hybrid.yml"
PROXY_PID_FILE="/tmp/whisper-proxy.pid"
CONFIG_FILE="$HOME/.voicemode-local/config"

# Shared compute-mode helpers (vm_detect_gpu, vm_read_config, ...).
VM_CONFIG_FILE="$CONFIG_FILE"
# shellcheck source=lib/compute.sh
[ -f "$SCRIPT_DIR/lib/compute.sh" ] && . "$SCRIPT_DIR/lib/compute.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }

docker_compose_cmd() {
    # Build the docker compose command honoring two config axes:
    #   PIPER_ENABLED  -> include the piper profile
    #   COMPUTE_MODE   -> stack the GPU override (cpu | gpu)
    # WHISPER_MODEL is exported so the compose ${WHISPER_MODEL} interpolation resolves.
    local piper_enabled compute_mode
    piper_enabled="$(vm_read_config PIPER_ENABLED false)"
    compute_mode="$(vm_read_config COMPUTE_MODE cpu)"

    export WHISPER_MODEL="$(vm_read_config WHISPER_MODEL "$(vm_recommended_whisper_model "$compute_mode")")"

    local files=(-f "$COMPOSE_FILE")
    case "$compute_mode" in
        gpu)    [ -f "$GPU_COMPOSE_FILE" ]    && files+=(-f "$GPU_COMPOSE_FILE") ;;
        hybrid) [ -f "$HYBRID_COMPOSE_FILE" ] && files+=(-f "$HYBRID_COMPOSE_FILE") ;;
    esac

    if [ "$piper_enabled" = "true" ]; then
        docker compose "${files[@]}" --profile piper "$@"
    else
        docker compose "${files[@]}" "$@"
    fi
}

check_service() {
    local name="$1" url="$2"
    if curl -sf --max-time 2 "$url" > /dev/null 2>&1; then
        ok "$name is running ($url)"
        return 0
    else
        fail "$name is not reachable ($url)"
        return 1
    fi
}

check_proxy() {
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
        ok "Whisper proxy is running (PID $(cat "$PROXY_PID_FILE"))"
        return 0
    else
        fail "Whisper proxy is not running"
        return 1
    fi
}

update_env() {
    # Args are COMMA-SEPARATED endpoint LISTS (priority order, OpenAI last).
    # We write the *plural* VOICEMODE_*_BASE_URLS vars into the STABLE config
    # file ~/.voicemode/voicemode.env (NOT ~/.claude.json). voice-mode loads
    # this file at startup and it is the single source of truth for both native
    # WSL sessions and the cross-OS bridge (which runs the same WSL binary), so
    # no .claude.json env / WSLENV plumbing is needed. NOTE: real environment
    # variables override this file, so the routing vars must NOT also be set in
    # ~/.claude.json's env block (we keep only secrets like OPENAI_API_KEY there).
    local stt_urls="$1" tts_urls="$2" voices="$3" mode="${4:-custom}"
    python3 - "$stt_urls" "$tts_urls" "$voices" "$mode" << 'PYEOF'
import os, re, sys

stt, tts, voices, mode = sys.argv[1:5]
envfile = os.path.expanduser("~/.voicemode/voicemode.env")
os.makedirs(os.path.dirname(envfile), exist_ok=True)

BEGIN = "# >>> voicemode-switch managed (do not edit inside this block) >>>"
END = "# <<< voicemode-switch managed <<<"

txt = ""
if os.path.exists(envfile):
    txt = open(envfile).read()
    txt = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", "", txt, flags=re.S)

block = [BEGIN, f"# mode: {mode}"]
if stt:
    block.append(f"VOICEMODE_STT_BASE_URLS={stt}")
if tts:
    block.append(f"VOICEMODE_TTS_BASE_URLS={tts}")
if voices:
    block.append(f"VOICEMODE_VOICES={voices}")
block.append(END)

body = txt.rstrip("\n")
out = (body + "\n\n" if body else "") + "\n".join(block) + "\n"
open(envfile, "w").write(out)
os.chmod(envfile, 0o600)
print(f"  Updated {envfile} (mode: {mode})")
PYEOF
    strip_claude_json_routing
}

# Remove routing vars from ~/.claude.json so they don't override voicemode.env
# (env vars take precedence). Keeps OPENAI_API_KEY and any WSLENV (trimmed to
# the key only). Safe no-op if the file/keys are absent.
strip_claude_json_routing() {
    python3 << 'PYEOF'
import json, os
p = os.path.expanduser("~/.claude.json")
if not os.path.exists(p):
    raise SystemExit(0)
data = json.load(open(p))
vm = data.get("mcpServers", {}).get("voicemode")
if not vm:
    raise SystemExit(0)
env = vm.get("env", {})
for k in ("VOICEMODE_STT_BASE_URLS", "VOICEMODE_TTS_BASE_URLS", "VOICEMODE_VOICES",
          "STT_BASE_URL", "TTS_BASE_URL", "TTS_VOICE"):
    env.pop(k, None)
if "WSLENV" in env:
    keep = [p for p in env["WSLENV"].split(":") if p.startswith("OPENAI_API_KEY")]
    if keep:
        env["WSLENV"] = ":".join(keep)
    else:
        env.pop("WSLENV", None)
vm["env"] = env
json.dump(data, open(p, "w"), indent=2)
print("  Cleaned routing vars from ~/.claude.json (now sourced from voicemode.env)")
PYEOF
}

cmd_status() {
    echo "=== VoiceMode Service Status ==="
    echo ""
    if is_kokoro_onnx; then
        echo "Kokoro ONNX (native):"
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            ok "Kokoro ONNX server running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            fail "Kokoro ONNX server not running"
        fi
        check_service "Kokoro ONNX TTS" "http://127.0.0.1:8880/health" || true
    else
        echo "Docker containers:"
        check_service "Kokoro TTS" "http://127.0.0.1:8880/v1/models" || true
    fi
    check_service "Whisper ASR" "http://127.0.0.1:9000/docs" || true
    echo ""
    echo "Proxy:"
    check_proxy || true
    check_service "Whisper Proxy (OpenAI-compat)" "http://127.0.0.1:2022/health" || true

    echo ""
    echo "Piper:"
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        ok "Piper proxy is running (PID $(cat "$PIPER_PID_FILE"))"
    else
        fail "Piper proxy is not running"
    fi
    check_service "Piper Proxy (OpenAI-compat)" "http://127.0.0.1:8881/health" || true

    echo ""
    echo "Current routing config (~/.voicemode/voicemode.env):"
    python3 -c "
import os, re
envfile = os.path.expanduser('~/.voicemode/voicemode.env')
text = open(envfile).read() if os.path.exists(envfile) else ''
def val(k, default='(not set — voice-mode default)'):
    m = re.search(rf'^{re.escape(k)}=(.*)\$', text, re.M)
    return m.group(1) if m else default
mode = re.search(r'^# mode: (.*)\$', text, re.M)
print(f'  Mode: {mode.group(1) if mode else \"(unset)\"}')
print(f'  STT:   {val(\"VOICEMODE_STT_BASE_URLS\")}')
print(f'  TTS:   {val(\"VOICEMODE_TTS_BASE_URLS\")}')
print(f'  Voice: {val(\"VOICEMODE_VOICES\")}')
import json
ce = json.load(open(os.path.expanduser('~/.claude.json'))).get('mcpServers', {}).get('voicemode', {}).get('env', {}) if os.path.exists(os.path.expanduser('~/.claude.json')) else {}
print(f'  OpenAI key (in .claude.json): {\"set\" if ce.get(\"OPENAI_API_KEY\") else \"NOT SET\"}')
"
}

is_kokoro_onnx() {
    local onnx="false"
    if [ -f "$CONFIG_FILE" ]; then
        onnx="$(grep -oP 'KOKORO_ONNX=\K.*' "$CONFIG_FILE" 2>/dev/null || echo "false")"
    fi
    [ "$onnx" = "true" ]
}

# Which local proxy ports the *current* config (voicemode.env) actually uses.
configured_local_ports() {
    python3 - << 'PYEOF'
import os, re
envfile = os.path.expanduser("~/.voicemode/voicemode.env")
text = open(envfile).read() if os.path.exists(envfile) else ""
def val(key):
    m = re.search(rf"^{re.escape(key)}=(.*)$", text, re.M)
    return m.group(1) if m else ""
urls = val("VOICEMODE_TTS_BASE_URLS") + "," + val("VOICEMODE_STT_BASE_URLS")
# Fall back to the local default if nothing is configured yet.
if not urls.strip(","):
    urls = "8880,8881,2022"
print(" ".join(p for p in ("8880", "8881", "2022") if p in urls))
PYEOF
}

healthy() {
    # $1 = port. True if the local service answers /health or /v1/models.
    curl -sf --max-time 2 "http://127.0.0.1:$1/health"     > /dev/null 2>&1 && return 0
    curl -sf --max-time 2 "http://127.0.0.1:$1/v1/models"  > /dev/null 2>&1 && return 0
    return 1
}

# Start a proxy DETACHED (own session via setsid) so it outlives the Claude
# session / MCP wrapper that launched it. Idempotent via PID file.
start_detached() {
    local label="$1" pidfile="$2"; shift 2
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return 0; fi
    setsid nohup "$@" >> "/tmp/${label}.log" 2>&1 < /dev/null &
    echo $! > "$pidfile"
}

# Ensure exactly the proxies the current config needs are up. Started detached,
# so they survive the launching session and stay up for the others. Idempotent
# and serialized across concurrent session starts via a lock.
cmd_ensure() {
    local quiet="${1:-}"
    exec 9>"/tmp/voicemode-ensure.lock"
    flock 9 2>/dev/null || true
    for port in $(configured_local_ports); do
        if healthy "$port"; then continue; fi
        case "$port" in
            8880)
                if is_kokoro_onnx; then
                    start_detached kokoro-onnx-server /tmp/kokoro-onnx-server.pid \
                        "$VENV_PY" "$SCRIPT_DIR/kokoro-onnx-server.py" --port 8880 \
                        --model-dir "$SCRIPT_DIR/models/kokoro"
                else
                    docker_compose_cmd up -d > /dev/null 2>&1 || true
                fi
                [ -n "$quiet" ] || echo "  ensured Kokoro (8880)" ;;
            8881)
                start_detached piper-proxy /tmp/piper-proxy.pid \
                    "$VENV_PY" "$SCRIPT_DIR/piper-proxy.py" --port 8881 \
                    --voices-file "$SCRIPT_DIR/voices/piper-voices.json" \
                    --models-dir "$SCRIPT_DIR/models/piper"
                [ -n "$quiet" ] || echo "  ensured Piper (8881)" ;;
            2022)
                start_detached whisper-proxy /tmp/whisper-proxy.pid \
                    python3 "$SCRIPT_DIR/whisper-proxy.py" --port 2022 \
                    --whisper-url http://127.0.0.1:9000
                [ -n "$quiet" ] || echo "  ensured Whisper proxy (2022)" ;;
        esac
    done
    flock -u 9 2>/dev/null || true
}

# Structured health probe of the configured endpoints (exit 0 iff all up).
cmd_health() {
    local all_up=0
    echo "=== VoiceMode health (configured local proxies) ==="
    local ports; ports="$(configured_local_ports)"
    [ -n "$ports" ] || { echo "  (no local proxies configured)"; return 0; }
    for port in $ports; do
        case "$port" in 8880) n="Kokoro TTS";; 8881) n="Piper TTS";; 2022) n="Whisper STT";; *) n="port $port";; esac
        if healthy "$port"; then ok "$n ($port) up"; else fail "$n ($port) DOWN"; all_up=1; fi
    done
    return $all_up
}

cmd_start() {
    echo "=== Starting Local VoiceMode Services ==="

    if is_kokoro_onnx; then
        echo ""
        echo "Starting Kokoro ONNX server (native)..."
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            warn "Kokoro ONNX server already running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            if lsof -ti:8880 > /dev/null 2>&1; then
                kill "$(lsof -ti:8880)" 2>/dev/null
                sleep 1
            fi
            nohup "$VENV_PY" "$SCRIPT_DIR/kokoro-onnx-server.py" --port 8880 \
                --model-dir "$SCRIPT_DIR/models/kokoro" \
                > /tmp/kokoro-onnx-server.log 2>&1 &
            echo $! > "$KOKORO_ONNX_PID_FILE"
            sleep 2
            if kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
                ok "Kokoro ONNX server started (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
            else
                fail "Kokoro ONNX server failed - check /tmp/kokoro-onnx-server.log"
            fi
        fi
    else
        echo ""
        echo "Starting Docker containers..."
        docker_compose_cmd up -d 2>&1 | sed 's/^/  /'
    fi

    echo ""
    echo "Starting Whisper proxy..."
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
        warn "Proxy already running (PID $(cat "$PROXY_PID_FILE"))"
    else
        # Wait for whisper service
        echo "  Waiting for Whisper ASR to be ready..."
        for i in $(seq 1 30); do
            if curl -sf --max-time 2 "http://127.0.0.1:9000/docs" > /dev/null 2>&1; then
                break
            fi
            sleep 1
        done

        nohup python3 "$SCRIPT_DIR/whisper-proxy.py" --port 2022 --whisper-url http://127.0.0.1:9000 \
            > /tmp/whisper-proxy.log 2>&1 &
        echo $! > "$PROXY_PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
            ok "Proxy started (PID $(cat "$PROXY_PID_FILE"))"
        else
            fail "Proxy failed to start — check /tmp/whisper-proxy.log"
        fi
    fi

    echo ""
    echo "Starting Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        warn "Piper proxy already running (PID $(cat "$PIPER_PID_FILE"))"
    else
        nohup "$VENV_PY" "$SCRIPT_DIR/piper-proxy.py" --port 8881 \
            --voices-file "$SCRIPT_DIR/voices/piper-voices.json" \
            --models-dir "$SCRIPT_DIR/models/piper" \
            > /tmp/piper-proxy.log 2>&1 &
        echo $! > "$PIPER_PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
            ok "Piper proxy started (PID $(cat "$PIPER_PID_FILE"))"
        else
            fail "Piper proxy failed to start — check /tmp/piper-proxy.log"
        fi
    fi

    echo ""
    cmd_status
}

cmd_stop() {
    echo "=== Stopping Local VoiceMode Services ==="

    echo ""
    echo "Stopping proxy..."
    if [ -f "$PROXY_PID_FILE" ]; then
        kill "$(cat "$PROXY_PID_FILE")" 2>/dev/null && ok "Proxy stopped" || warn "Proxy was not running"
        rm -f "$PROXY_PID_FILE"
    else
        warn "No proxy PID file found"
    fi

    echo ""
    echo "Stopping Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ]; then
        kill "$(cat "$PIPER_PID_FILE")" 2>/dev/null && ok "Piper proxy stopped" || warn "Piper proxy was not running"
        rm -f "$PIPER_PID_FILE"
    else
        warn "No Piper proxy PID file found"
    fi

    echo ""
    KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
    if [ -f "$KOKORO_ONNX_PID_FILE" ]; then
        echo "Stopping Kokoro ONNX server..."
        kill "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null && ok "Kokoro ONNX server stopped" || warn "Kokoro ONNX was not running"
        rm -f "$KOKORO_ONNX_PID_FILE"
    fi

    echo ""
    echo "Stopping Docker containers..."
    docker_compose_cmd down 2>&1 | sed 's/^/  /'

    ok "All local services stopped"
}

# Endpoint building blocks (priority order matters; OpenAI is always last)
KOKORO_URL="http://127.0.0.1:8880/v1"
PIPER_URL="http://127.0.0.1:8881/v1"
WHISPER_URL="http://127.0.0.1:2022/v1"
OPENAI_URL="https://api.openai.com/v1"

