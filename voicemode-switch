#!/usr/bin/env bash
#
# voicemode-switch — Switch VoiceMode between local and OpenAI backends
#
# Usage:
#   voicemode-switch local    # Use local Whisper STT + Kokoro TTS
#   voicemode-switch openai   # Use OpenAI for both STT and TTS
#   voicemode-switch hybrid   # Use local Kokoro TTS + OpenAI Whisper STT
#   voicemode-switch status   # Show current config and service health
#   voicemode-switch start    # Start local services (Docker + proxy)
#   voicemode-switch stop     # Stop local services
#   voicemode-switch queue    # Show voice session queue (floor holder + waiters)
#
# After switching, restart Claude Code for changes to take effect.

set -euo pipefail

CLAUDE_JSON="$HOME/.claude.json"
# Resolve symlinks to find the real project directory
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
PROXY_PID_FILE="/tmp/whisper-proxy.pid"
CONFIG_FILE="$HOME/.voicemode-local/config"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }

docker_compose_cmd() {
    # Build docker compose command with piper profile if enabled in config
    local piper_enabled="false"
    if [ -f "$CONFIG_FILE" ]; then
        piper_enabled="$(grep -oP 'PIPER_ENABLED=\K.*' "$CONFIG_FILE" 2>/dev/null || echo "false")"
    fi
    if [ "$piper_enabled" = "true" ]; then
        docker compose -f "$COMPOSE_FILE" --profile piper "$@"
    else
        docker compose -f "$COMPOSE_FILE" "$@"
    fi
}

check_service() {
    local name="$1" url="$2"
    if curl -sf --max-time 2 "$url" > /dev/null 2>&1; then
        ok "$name is running ($url)"
        return 0
    else
        fail "$name is not reachable ($url)"
        return 1
    fi
}

check_proxy() {
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
        ok "Whisper proxy is running (PID $(cat "$PROXY_PID_FILE"))"
        return 0
    else
        fail "Whisper proxy is not running"
        return 1
    fi
}

update_env() {
    # Args are COMMA-SEPARATED endpoint LISTS (priority order, OpenAI last).
    # voice-mode only reads the *plural* VOICEMODE_*_BASE_URLS vars — the older
    # singular TTS_BASE_URL/STT_BASE_URL/TTS_VOICE are NOT read by this version,
    # so writing them is a silent no-op. Always write the plural list vars.
    local stt_urls="$1" tts_urls="$2" voices="$3"
    python3 << PYEOF
import json, os

claude_json = os.path.expanduser("~/.claude.json")
with open(claude_json) as f:
    data = json.load(f)

env = data["mcpServers"]["voicemode"]["env"]
openai_key = env.get("OPENAI_API_KEY", "")

new_env = {"OPENAI_API_KEY": openai_key}
stt_urls = "${stt_urls}"
tts_urls = "${tts_urls}"
voices = "${voices}"

if stt_urls:
    new_env["VOICEMODE_STT_BASE_URLS"] = stt_urls
if tts_urls:
    new_env["VOICEMODE_TTS_BASE_URLS"] = tts_urls
if voices:
    new_env["VOICEMODE_VOICES"] = voices

data["mcpServers"]["voicemode"]["env"] = new_env

with open(claude_json, "w") as f:
    json.dump(data, f, indent=2)

print("  Updated ~/.claude.json (VOICEMODE_TTS_BASE_URLS / VOICEMODE_STT_BASE_URLS)")
PYEOF
}

cmd_status() {
    echo "=== VoiceMode Service Status ==="
    echo ""
    if is_kokoro_onnx; then
        echo "Kokoro ONNX (native):"
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            ok "Kokoro ONNX server running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            fail "Kokoro ONNX server not running"
        fi
        check_service "Kokoro ONNX TTS" "http://127.0.0.1:8880/health" || true
    else
        echo "Docker containers:"
        check_service "Kokoro TTS" "http://127.0.0.1:8880/v1/models" || true
    fi
    check_service "Whisper ASR" "http://127.0.0.1:9000/docs" || true
    echo ""
    echo "Proxy:"
    check_proxy || true
    check_service "Whisper Proxy (OpenAI-compat)" "http://127.0.0.1:2022/health" || true

    echo ""
    echo "Piper:"
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        ok "Piper proxy is running (PID $(cat "$PIPER_PID_FILE"))"
    else
        fail "Piper proxy is not running"
    fi
    check_service "Piper Proxy (OpenAI-compat)" "http://127.0.0.1:8881/health" || true

    echo ""
    echo "Current config in ~/.claude.json:"
    python3 -c "
import json, os
with open(os.path.expanduser('~/.claude.json')) as f:
    data = json.load(f)
env = data.get('mcpServers', {}).get('voicemode', {}).get('env', {})
stt = env.get('STT_BASE_URL', '(not set — using OpenAI)')
tts = env.get('TTS_BASE_URL', '(not set — using OpenAI)')
voice = env.get('TTS_VOICE', '(not set — using default)')
print(f'  STT: {stt}')
print(f'  TTS: {tts}')
print(f'  Voice: {voice}')
has_key = bool(env.get('OPENAI_API_KEY', ''))
print(f'  OpenAI key: {\"set\" if has_key else \"NOT SET\"} ')
"
}

is_kokoro_onnx() {
    local onnx="false"
    if [ -f "$CONFIG_FILE" ]; then
        onnx="$(grep -oP 'KOKORO_ONNX=\K.*' "$CONFIG_FILE" 2>/dev/null || echo "false")"
    fi
    [ "$onnx" = "true" ]
}

cmd_start() {
    echo "=== Starting Local VoiceMode Services ==="

    if is_kokoro_onnx; then
        echo ""
        echo "Starting Kokoro ONNX server (native)..."
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            warn "Kokoro ONNX server already running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            if lsof -ti:8880 > /dev/null 2>&1; then
                kill "$(lsof -ti:8880)" 2>/dev/null
                sleep 1
            fi
            nohup python3 "$SCRIPT_DIR/kokoro-onnx-server.py" --port 8880 \
                --model-dir "$SCRIPT_DIR/models/kokoro" \
                > /tmp/kokoro-onnx-server.log 2>&1 &
            echo $! > "$KOKORO_ONNX_PID_FILE"
            sleep 2
            if kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
                ok "Kokoro ONNX server started (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
            else
                fail "Kokoro ONNX server failed - check /tmp/kokoro-onnx-server.log"
            fi
        fi
    else
        echo ""
        echo "Starting Docker containers..."
        docker_compose_cmd up -d 2>&1 | sed 's/^/  /'
    fi

    echo ""
    echo "Starting Whisper proxy..."
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
        warn "Proxy already running (PID $(cat "$PROXY_PID_FILE"))"
    else
        # Wait for whisper service
        echo "  Waiting for Whisper ASR to be ready..."
        for i in $(seq 1 30); do
            if curl -sf --max-time 2 "http://127.0.0.1:9000/docs" > /dev/null 2>&1; then
                break
            fi
            sleep 1
        done

        nohup python3 "$SCRIPT_DIR/whisper-proxy.py" --port 2022 --whisper-url http://127.0.0.1:9000 \
            > /tmp/whisper-proxy.log 2>&1 &
        echo $! > "$PROXY_PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
            ok "Proxy started (PID $(cat "$PROXY_PID_FILE"))"
        else
            fail "Proxy failed to start — check /tmp/whisper-proxy.log"
        fi
    fi

    echo ""
    echo "Starting Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        warn "Piper proxy already running (PID $(cat "$PIPER_PID_FILE"))"
    else
        nohup python3 "$SCRIPT_DIR/piper-proxy.py" --port 8881 \
            --voices-file "$SCRIPT_DIR/voices/piper-voices.json" \
            --models-dir "$SCRIPT_DIR/models/piper" \
            > /tmp/piper-proxy.log 2>&1 &
        echo $! > "$PIPER_PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
            ok "Piper proxy started (PID $(cat "$PIPER_PID_FILE"))"
        else
            fail "Piper proxy failed to start — check /tmp/piper-proxy.log"
        fi
    fi

    echo ""
    cmd_status
}

cmd_stop() {
    echo "=== Stopping Local VoiceMode Services ==="

    echo ""
    echo "Stopping proxy..."
    if [ -f "$PROXY_PID_FILE" ]; then
        kill "$(cat "$PROXY_PID_FILE")" 2>/dev/null && ok "Proxy stopped" || warn "Proxy was not running"
        rm -f "$PROXY_PID_FILE"
    else
        warn "No proxy PID file found"
    fi

    echo ""
    echo "Stopping Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ]; then
        kill "$(cat "$PIPER_PID_FILE")" 2>/dev/null && ok "Piper proxy stopped" || warn "Piper proxy was not running"
        rm -f "$PIPER_PID_FILE"
    else
        warn "No Piper proxy PID file found"
    fi

    echo ""
    KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
    if [ -f "$KOKORO_ONNX_PID_FILE" ]; then
        echo "Stopping Kokoro ONNX server..."
        kill "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null && ok "Kokoro ONNX server stopped" || warn "Kokoro ONNX was not running"
        rm -f "$KOKORO_ONNX_PID_FILE"
    fi

    echo ""
    echo "Stopping Docker containers..."
    docker_compose_cmd down 2>&1 | sed 's/^/  /'

    ok "All local services stopped"
}

# Endpoint building blocks (priority order matters; OpenAI is always last)
KOKORO_URL="http://127.0.0.1:8880/v1"
PIPER_URL="http://127.0.0.1:8881/v1"
WHISPER_URL="http://127.0.0.1:2022/v1"
OPENAI_URL="https://api.openai.com/v1"

cmd_local() {
    echo "=== Switching to LOCAL mode (Kokoro + Piper, OpenAI last resort) ==="
    echo "  STT: Local Whisper (2022) -> OpenAI fallback"
    echo "  TTS: Local Kokoro (8880) + Piper (8881), equal -> OpenAI last resort"
    echo ""

    update_env "$WHISPER_URL,$OPENAI_URL" "$KOKORO_URL,$PIPER_URL,$OPENAI_URL" "af_sky"

    echo ""
    warn "Restart Claude Code for changes to take effect"
    echo "  Make sure local services are running: voicemode-switch start"
}

cmd_localonly() {
    echo "=== Switching to LOCAL-ONLY mode (no cloud, fails loud if locals down) ==="
    echo "  STT: Local Whisper (2022) only"
    echo "  TTS: Local Kokoro (8880) + Piper (8881) only"
    echo ""

    update_env "$WHISPER_URL" "$KOKORO_URL,$PIPER_URL" "af_sky"

    echo ""
    warn "Restart Claude Code for changes to take effect"
    echo "  Make sure local services are running: voicemode-switch start"
}

cmd_openai() {
    echo "=== Switching to OPENAI mode (cloud only) ==="
    echo "  STT: OpenAI Whisper (cloud)"
    echo "  TTS: OpenAI TTS (cloud)"
    echo ""

    update_env "$OPENAI_URL" "$OPENAI_URL" "nova"

    echo ""
    warn "Restart Claude Code for changes to take effect"
}

cmd_hybrid() {
    echo "=== Switching to HYBRID mode (cloud STT, local TTS) ==="
    echo "  STT: OpenAI Whisper (cloud) -> local Whisper fallback"
    echo "  TTS: Local Kokoro (8880) + Piper (8881) -> OpenAI last resort"
    echo ""

    update_env "$OPENAI_URL,$WHISPER_URL" "$KOKORO_URL,$PIPER_URL,$OPENAI_URL" "af_sky"

    echo ""
    warn "Restart Claude Code for changes to take effect"
    echo "  Make sure Kokoro is running: voicemode-switch start"
}

cmd_piper() {
    echo "=== Switching to PIPER mode (Piper primary, Kokoro + OpenAI behind) ==="
    echo "  STT: Local Whisper (2022) -> OpenAI fallback"
    echo "  TTS: Local Piper (8881) primary + Kokoro (8880) -> OpenAI last resort"
    echo ""

    update_env "$WHISPER_URL,$OPENAI_URL" "$PIPER_URL,$KOKORO_URL,$OPENAI_URL" "p_de_thorsten"

    echo ""
    warn "Restart Claude Code for changes to take effect"
    echo "  Make sure local services are running: voicemode-switch start"
}

case "${1:-}" in
    local)     cmd_local ;;
    localonly) cmd_localonly ;;
    openai)    cmd_openai ;;
    hybrid)    cmd_hybrid ;;
    piper)     cmd_piper ;;
    status)    cmd_status ;;
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    queue)
        PYBIN="$SCRIPT_DIR/.venv/bin/python"
        [ -x "$PYBIN" ] || PYBIN="python3"
        "$PYBIN" -c "import sys; sys.path.insert(0, '$SCRIPT_DIR/patches'); import voice_queue; voice_queue.print_status()"
        ;;
    queue-log)
        LOG="$HOME/.voicemode/logs/queue.log"
        if [ ! -f "$LOG" ]; then
            warn "No queue log yet at $LOG (no session has run the queue since logging was added)"
            exit 0
        fi
        echo "Tailing $LOG (Ctrl-C to stop)..."
        tail -n 40 -f "$LOG"
        ;;
    sysaudio)
        PYBIN="$SCRIPT_DIR/.venv/bin/python"
        [ -x "$PYBIN" ] || PYBIN="python3"
        PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" \
            "$PYBIN" -m voicemode_sysaudio "${2:-status}"
        ;;
    *)
        echo "Usage: voicemode-switch <command>"
        echo ""
        echo "Commands:"
        echo "  local     Local Kokoro+Piper TTS & Whisper STT, OpenAI last resort (recommended)"
        echo "  localonly Local Kokoro+Piper+Whisper only, no cloud (fails loud if down)"
        echo "  openai    Use OpenAI for both STT and TTS (cloud only)"
        echo "  hybrid    Local Kokoro+Piper TTS + OpenAI STT"
        echo "  piper     Piper TTS primary (German etc.), Kokoro+OpenAI behind"
        echo "  status   Show current config and service health"
        echo "  start    Start local Docker services + proxy"
        echo "  stop     Stop local services"
        echo "  queue    Show voice session queue (floor holder + waiters)"
        echo "  queue-log Tail the per-session queue event log (debug)"
        echo "  sysaudio  Fold system output into voice input: on|off|status|setup|teardown"
        echo ""
        echo "After switching modes, restart Claude Code for changes to take effect."
        ;;
esac
