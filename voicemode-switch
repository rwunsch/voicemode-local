#!/usr/bin/env bash
#
# voicemode-switch — Switch VoiceMode between local and OpenAI backends
#
# Usage:
#   voicemode-switch local    # Use local Whisper STT + Kokoro TTS
#   voicemode-switch openai   # Use OpenAI for both STT and TTS
#   voicemode-switch hybrid   # Use local Kokoro TTS + OpenAI Whisper STT
#   voicemode-switch status   # Show current config and service health
#   voicemode-switch start    # Start local services (Docker + proxy)
#   voicemode-switch stop     # Stop local services
#   voicemode-switch queue    # Show voice session queue (floor holder + waiters)
#
# After switching, restart Claude Code for changes to take effect.

set -euo pipefail

CLAUDE_JSON="$HOME/.claude.json"
# Resolve symlinks to find the real project directory
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# Python from the project venv. Proxies that import heavy deps (piper-tts,
# kokoro-onnx) MUST run under this, NOT the ambient `python3`. When a proxy is
# auto-started from Claude Code's MCP environment, bare `python3` resolves to a
# system/linuxbrew interpreter WITHOUT those packages — piper-proxy then falls
# back to spawning the piper CLI, which reloads its 100MB+ model on every
# request (~7-34s), blowing past voice-mode's client timeout and silently
# routing German to OpenAI (English voice). The venv python enables the warm
# in-process path (~0.5s/request).
VENV_PY="$SCRIPT_DIR/.venv/bin/python"
[ -x "$VENV_PY" ] || VENV_PY="python3"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yml"
GPU_COMPOSE_FILE="$SCRIPT_DIR/docker-compose.gpu.yml"
HYBRID_COMPOSE_FILE="$SCRIPT_DIR/docker-compose.hybrid.yml"
PROXY_PID_FILE="/tmp/whisper-proxy.pid"
CONFIG_FILE="$HOME/.voicemode-local/config"
SILERO_MODEL="$SCRIPT_DIR/models/silero/silero_vad.onnx"
SILERO_URL="https://raw.githubusercontent.com/snakers4/silero-vad/bfdc0193023f121ea5b3cc7b176dbed570a68a59/src/silero_vad/data/silero_vad.onnx"
SILERO_SHA256="1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3"

# Shared compute-mode helpers (vm_detect_gpu, vm_read_config, ...).
VM_CONFIG_FILE="$CONFIG_FILE"
# shellcheck source=lib/compute.sh
[ -f "$SCRIPT_DIR/lib/compute.sh" ] && . "$SCRIPT_DIR/lib/compute.sh"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "  ${GREEN}✓${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }
warn() { echo -e "  ${YELLOW}!${NC} $1"; }

# --- voicemode.env writes: one writer at a time ------------------------------------
# Every write to ~/.voicemode/voicemode.env holds flock(2) on voicemode.env.lock beside it,
# the lock the native switch takes (scripts/windows/voicemode_native.py settings_lock), so
# this switch, the native one and the pill cannot lose each other's change. macOS has no
# flock binary, so python's fcntl takes the lock on fd 8, which this shell holds open: an
# flock belongs to the open file, so it outlives the python and ends when fd 8 is closed.
_ENV_LOCK_PY='import fcntl, sys, time
deadline = time.monotonic() + float(sys.argv[1])
while True:
    try:
        fcntl.flock(8, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except BlockingIOError:
        if time.monotonic() >= deadline:
            sys.exit(3)
        time.sleep(0.05)'

with_env_lock() {
    if [ -n "${_VM_ENV_LOCKED:-}" ]; then "$@"; return; fi   # already held by this shell
    local lock="$HOME/.voicemode/voicemode.env.lock" wait_s="${VOICEMODE_ENV_LOCK_TIMEOUT:-10}" rc=0 err
    mkdir -p "$HOME/.voicemode"
    exec 8>>"$lock"
    # exit 3 is the helper's own "timed out"; anything else is the helper failing
    # (no interpreter, bad timeout value). Both fail closed: nothing is written.
    err="$("$VENV_PY" -c "$_ENV_LOCK_PY" "$wait_s" 2>&1)" || {
        rc=$?
        exec 8>&-
        if [ "$rc" -eq 3 ]; then
            fail "voicemode.env not changed: another writer held $lock for ${wait_s} s"
        else
            fail "voicemode.env not changed: could not take the settings lock: ${err##*$'\n'} (exit $rc)"
        fi
        return 1
    }
    _VM_ENV_LOCKED=1
    "$@" || rc=$?
    _VM_ENV_LOCKED=
    exec 8>&-
    return $rc
}

docker_compose_cmd() {
    # Build the docker compose command honoring two config axes:
    #   PIPER_ENABLED  -> include the piper profile
    #   COMPUTE_MODE   -> stack the GPU override (cpu | gpu)
    # WHISPER_MODEL is exported so the compose ${WHISPER_MODEL} interpolation resolves.
    local piper_enabled compute_mode
    piper_enabled="$(vm_read_config PIPER_ENABLED false)"
    compute_mode="$(vm_read_config COMPUTE_MODE cpu)"

    export WHISPER_MODEL="$(vm_read_config WHISPER_MODEL "$(vm_recommended_whisper_model "$compute_mode")")"

    local files=(-f "$COMPOSE_FILE")
    case "$compute_mode" in
        gpu)    [ -f "$GPU_COMPOSE_FILE" ]    && files+=(-f "$GPU_COMPOSE_FILE") ;;
        hybrid) [ -f "$HYBRID_COMPOSE_FILE" ] && files+=(-f "$HYBRID_COMPOSE_FILE") ;;
    esac

    if [ "$piper_enabled" = "true" ]; then
        docker compose "${files[@]}" --profile piper "$@"
    else
        docker compose "${files[@]}" "$@"
    fi
}

check_service() {
    local name="$1" url="$2"
    if curl -sf --max-time 2 "$url" > /dev/null 2>&1; then
        ok "$name is running ($url)"
        return 0
    else
        fail "$name is not reachable ($url)"
        return 1
    fi
}

check_proxy() {
    if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
        ok "Whisper proxy is running (PID $(cat "$PROXY_PID_FILE"))"
        return 0
    else
        fail "Whisper proxy is not running"
        return 1
    fi
}

update_env() {
    # Args are COMMA-SEPARATED endpoint LISTS (priority order, OpenAI last).
    # We write the *plural* VOICEMODE_*_BASE_URLS vars into the STABLE config
    # file ~/.voicemode/voicemode.env (NOT ~/.claude.json). voice-mode loads
    # this file at startup and it is the single source of truth for both native
    # WSL sessions and the cross-OS bridge (which runs the same WSL binary), so
    # no .claude.json env / WSLENV plumbing is needed. NOTE: real environment
    # variables override this file, so the routing vars must NOT also be set in
    # ~/.claude.json's env block (we keep only secrets like OPENAI_API_KEY there).
    # $5 (optional): a VOICEMODE_TTS_TIMEOUT_LOCAL to write into the block, unless the file
    # already sets it outside the block (a value the user set is never overwritten).
    local stt_urls="$1" tts_urls="$2" voices="$3" mode="${4:-custom}" tts_timeout_local="${5:-}"
    with_env_lock python3 - "$stt_urls" "$tts_urls" "$voices" "$mode" "$tts_timeout_local" << 'PYEOF'
import os, re, sys

stt, tts, voices, mode = sys.argv[1:5]
tts_timeout_local = sys.argv[5] if len(sys.argv) > 5 else ""
envfile = os.path.expanduser("~/.voicemode/voicemode.env")
os.makedirs(os.path.dirname(envfile), exist_ok=True)

BEGIN = "# >>> voicemode-switch managed (do not edit inside this block) >>>"
END = "# <<< voicemode-switch managed <<<"

txt = ""
if os.path.exists(envfile):
    txt = open(envfile).read()

MODE_VOICES = {"af_sky", "nova", "p_de_thorsten"}   # what the switch itself writes per mode
OPENAI_VOICES = {"alloy", "ash", "ballad", "coral", "echo", "fable", "nova", "onyx", "sage", "shimmer", "verse"}
pat = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", re.S)
old = pat.search(txt)
old_block = old.group(0) if old else ""
outside = pat.sub("", txt)

def value_in(text):
    found = re.findall(r"^VOICEMODE_VOICES=(.*)$", text, flags=re.M)
    return found[-1].strip() if found else ""

# A mode switch changes routing, not the voice: a voice the user has set stays. A voice that is
# just the default an earlier switch wrote follows the new mode (OpenAI rejects af_sky).
user_voice = value_in(outside)
kept = user_voice or (value_in(old_block) if value_in(old_block) not in MODE_VOICES else "")
if kept:
    voices = None if user_voice else kept
    if mode == "openai" and kept.split(",")[0] not in OPENAI_VOICES:
        print(f"  Note: kept your voice {kept}; cloud-only mode needs an OpenAI voice (e.g. nova)")

block = [BEGIN, f"# mode: {mode}"]
if stt:
    block.append(f"VOICEMODE_STT_BASE_URLS={stt}")
if tts:
    block.append(f"VOICEMODE_TTS_BASE_URLS={tts}")
if voices:
    block.append(f"VOICEMODE_VOICES={voices}")
if tts_timeout_local and not re.search(r"^\s*(export\s+)?VOICEMODE_TTS_TIMEOUT_LOCAL=", outside, re.M):
    block.append(f"VOICEMODE_TTS_TIMEOUT_LOCAL={tts_timeout_local}")
block.append(END)
block_text = "\n".join(block) + "\n"

if old:
    out = txt[:old.start()] + block_text + txt[old.end():]   # in place: nothing else moves
else:
    body = txt.rstrip("\n")
    out = (body + "\n\n" if body else "") + block_text
if out == txt and os.path.exists(envfile):
    print(f"  {envfile} already set (mode: {mode})")
else:
    open(envfile, "w").write(out)
    print(f"  Updated {envfile} (mode: {mode})")
os.chmod(envfile, 0o600)
PYEOF
    strip_claude_json_routing
}

# Remove routing vars from ~/.claude.json so they don't override voicemode.env
# (env vars take precedence). Keeps OPENAI_API_KEY and any WSLENV (trimmed to
# the key only). Safe no-op if the file/keys are absent.
strip_claude_json_routing() {
    python3 << 'PYEOF'
import json, os
p = os.path.expanduser("~/.claude.json")
if not os.path.exists(p):
    raise SystemExit(0)
data = json.load(open(p))
vm = data.get("mcpServers", {}).get("voicemode")
if not vm:
    raise SystemExit(0)
env = vm.get("env", {})
before = json.dumps(env, sort_keys=True)
for k in ("VOICEMODE_STT_BASE_URLS", "VOICEMODE_TTS_BASE_URLS", "VOICEMODE_VOICES",
          "STT_BASE_URL", "TTS_BASE_URL", "TTS_VOICE"):
    env.pop(k, None)
if "WSLENV" in env:
    keep = [p for p in env["WSLENV"].split(":") if p.startswith("OPENAI_API_KEY")]
    if keep:
        env["WSLENV"] = ":".join(keep)
    else:
        env.pop("WSLENV", None)
if json.dumps(env, sort_keys=True) == before:
    raise SystemExit(0)     # nothing to clean: leave the file and the screen alone
vm["env"] = env
json.dump(data, open(p, "w"), indent=2)
print("  Cleaned routing vars from ~/.claude.json (now sourced from voicemode.env)")
PYEOF
}

cmd_status() {
    echo "=== VoiceMode Service Status ==="
    echo ""
    local onnx_port; onnx_port="$(kokoro_onnx_port)"
    # Docker Kokoro still owns 8880 unless ONNX was configured to take it over.
    if ! is_kokoro_onnx || [ "$onnx_port" != "8880" ]; then
        echo "Docker containers:"
        # Probe with the SAME predicate `health` uses (/health, then /v1/models).
        # These used to be two different notions of "up", and they disagreed:
        # kokoro-fastapi-gpu:v0.2.0 answers /health but returns 404 for
        # /v1/models, so `status` called a perfectly healthy container
        # unreachable while `health` called it up. Fixed 2026-09-12.
        if healthy 8880; then
            ok "Kokoro TTS is running (http://127.0.0.1:8880)"
        else
            fail "Kokoro TTS is not reachable (http://127.0.0.1:8880)"
        fi
    fi
    if is_kokoro_onnx_gpu; then
        echo "Kokoro ONNX (native GPU, port $onnx_port):"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            ok "Kokoro ONNX server running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            fail "Kokoro ONNX server not running (log: /tmp/kokoro-onnx-server.log)"
        fi
        check_service "Kokoro ONNX TTS" "http://127.0.0.1:$onnx_port/health" || true
        # /health names the provider the session really runs on.
        local provider body reason
        body="$(curl -sf --max-time 2 "http://127.0.0.1:$onnx_port/health" 2>/dev/null || true)"
        provider="$(json_field "$body" provider)"
        [ -n "$body" ] && [ -z "$provider" ] && provider="unknown"
        reason="$(json_field "$body" fallback_reason)"
        case "$(kokoro_provider):$provider" in
            *:CUDAExecutionProvider) ok "Provider: $provider" ;;
            *:) ;;
            auto:*) warn "Provider: $provider (KOKORO_PROVIDER=auto fell back to the CPU: ${reason:-no reason given})" ;;
            cpu:*|directml:*|coreml:*) ok "Provider: $provider (KOKORO_PROVIDER=$(kokoro_provider))" ;;
            *) fail "Provider: $provider (not on the GPU; the server should have exited with --require-gpu)" ;;
        esac
        status_kokoro_settings
    elif is_kokoro_onnx; then
        echo "Kokoro ONNX (native, port $onnx_port):"
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            ok "Kokoro ONNX server running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            fail "Kokoro ONNX server not running"
        fi
        check_service "Kokoro ONNX TTS" "http://127.0.0.1:$onnx_port/health" || true
        status_kokoro_settings
    fi
    if is_faster_whisper; then
        echo ""
        echo "Speech recognition (faster-whisper, native, port 2022):"
        if [ -f "$FASTER_WHISPER_PID_FILE" ] && kill -0 "$(cat "$FASTER_WHISPER_PID_FILE")" 2>/dev/null; then
            ok "faster-whisper server running (PID $(cat "$FASTER_WHISPER_PID_FILE"))"
        else
            fail "faster-whisper server not running (log: /tmp/faster-whisper-server.log)"
        fi
        # /health is 200 only once the model is loaded and warmed up.
        check_service "faster-whisper STT (model loaded)" "http://127.0.0.1:2022/health" || true
    else
        check_service "Whisper ASR" "http://127.0.0.1:9000/docs" || true
        echo ""
        echo "Proxy:"
        check_proxy || true
        check_service "Whisper Proxy (OpenAI-compat)" "http://127.0.0.1:2022/health" || true
    fi
    status_cpu_fallbacks

    echo ""
    echo "Piper:"
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        ok "Piper proxy is running (PID $(cat "$PIPER_PID_FILE"))"
    else
        fail "Piper proxy is not running"
    fi
    check_service "Piper Proxy (OpenAI-compat)" "http://127.0.0.1:8881/health" || true

    echo ""
    echo "Current routing config (~/.voicemode/voicemode.env):"
    python3 -c "
import os, re
envfile = os.path.expanduser('~/.voicemode/voicemode.env')
text = open(envfile).read() if os.path.exists(envfile) else ''
def val(k, default='(not set — voice-mode default)'):
    m = re.search(rf'^{re.escape(k)}=(.*)\$', text, re.M)
    return m.group(1) if m else default
mode = re.search(r'^# mode: (.*)\$', text, re.M)
print(f'  Mode: {mode.group(1) if mode else \"(unset)\"}')
print(f'  STT:   {val(\"VOICEMODE_STT_BASE_URLS\")}')
print(f'  TTS:   {val(\"VOICEMODE_TTS_BASE_URLS\")}')
print(f'  Voice: {val(\"VOICEMODE_VOICES\")}')
import json
ce = json.load(open(os.path.expanduser('~/.claude.json'))).get('mcpServers', {}).get('voicemode', {}).get('env', {}) if os.path.exists(os.path.expanduser('~/.claude.json')) else {}
print(f'  OpenAI key (in .claude.json): {\"set\" if ce.get(\"OPENAI_API_KEY\") else \"NOT SET\"}')
"
}

# The CPU fallbacks in `status`: process (pid file), and what /health says it runs on.
status_cpu_fallbacks() {
    local port body value
    if is_kokoro_cpu_fallback; then
        port="$(kokoro_cpu_fallback_port)"
        echo ""
        echo "Kokoro CPU fallback (port $port):"
        if [ -f "$KOKORO_CPU_PID_FILE" ] && kill -0 "$(cat "$KOKORO_CPU_PID_FILE")" 2>/dev/null; then
            ok "Kokoro CPU fallback running (PID $(cat "$KOKORO_CPU_PID_FILE"))"
        else
            fail "Kokoro CPU fallback not running (log: /tmp/kokoro-cpu-fallback.log)"
        fi
        body="$(port_health_body "$port")" || true
        value="$(json_field "$body" provider)"
        if [ "$value" = "CPUExecutionProvider" ]; then
            ok "Provider: $value"
        elif [ -n "$value" ]; then
            fail "Provider: $value (not the CPU fallback this port is configured for)"
        fi
    fi
    if is_stt_cpu_fallback; then
        port="$(stt_cpu_fallback_port)"
        echo ""
        echo "Speech recognition CPU fallback (faster-whisper, port $port):"
        if [ -f "$STT_CPU_PID_FILE" ] && kill -0 "$(cat "$STT_CPU_PID_FILE")" 2>/dev/null; then
            ok "faster-whisper CPU fallback running (PID $(cat "$STT_CPU_PID_FILE"))"
        else
            fail "faster-whisper CPU fallback not running (log: /tmp/faster-whisper-cpu.log)"
        fi
        body="$(port_health_body "$port")" || true
        value="$(json_field "$body" device)"
        if [ "$value" = "cpu" ]; then
            ok "Device: cpu, model $(json_field "$body" model) ($(json_field "$body" status))"
        elif [ -n "$value" ]; then
            fail "Device: $value (not the CPU fallback this port is configured for)"
        fi
    fi
}

is_kokoro_onnx() {
    local onnx="false"
    if [ -f "$CONFIG_FILE" ]; then
        onnx="$(sed -n 's/^KOKORO_ONNX=//p' "$CONFIG_FILE" 2>/dev/null | tail -1)"
    fi
    [ "$onnx" = "true" ]
}

# Which port the ONNX Kokoro server listens on. Defaults to 8880, where it
# REPLACES the Docker Kokoro — that was the original design, and the port
# collision it causes is written up in docs/kokoro-port-collision/README.md.
#
# Set KOKORO_ONNX_PORT to something else (we use 8882) to run it ALONGSIDE the
# Docker one instead, as a local last resort in VOICEMODE_TTS_BASE_URLS. That
# is what replaced OpenAI at the end of our chain: measured 2026-09-12, ONNX is
# indistinguishable from Docker Kokoro by ear, so the only thing the cloud entry
# was still providing was a way for our words to leave the machine unnoticed.
kokoro_onnx_port() {
    local p=""
    if [ -f "$CONFIG_FILE" ]; then
        p="$(sed -n 's/^KOKORO_ONNX_PORT=//p' "$CONFIG_FILE" 2>/dev/null | tail -1)"
    fi
    echo "${p:-8880}"
}

# Native Kokoro on the GPU: KOKORO_ONNX_GPU=true (with KOKORO_ONNX=true) runs the same
# server from its own venv (KOKORO_ONNX_VENV) through scripts/kokoro-gpu-start.sh, which
# puts the venv's CUDA libraries on LD_LIBRARY_PATH, with --require-gpu, so a CUDA
# provider that fails to load ends the server rather than running it on the CPU.
# Unset or false: the CPU server from the repo venv, as before. See docs/native-gpu-tts.
KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
is_kokoro_onnx_gpu() { is_kokoro_onnx && [ "$(vm_read_config KOKORO_ONNX_GPU false)" = "true" ]; }
kokoro_onnx_venv() { vm_read_config KOKORO_ONNX_VENV "$HOME/.voicemode-local/kokoro-gpu-venv"; }

# Provider and threads (2026-11-17): KOKORO_PROVIDER=auto|cuda|cpu|directml|coreml and
# KOKORO_THREADS=N in the config become --provider / --threads. Unset (or threads 0):
# nothing is passed, as before. With the GPU engine a KOKORO_PROVIDER replaces
# --require-gpu (cuda is the same rule; auto falls back to the CPU and says why).
# See docs/native-gpu-tts/README.md, "Provider and threads".
# Read directly (as kokoro_onnx_port does): lib/compute.sh is optional for this script.
kokoro_config_value() {
    [ -f "$CONFIG_FILE" ] || return 0
    sed -n "s/^$1=//p" "$CONFIG_FILE" 2>/dev/null | tail -1
}
kokoro_provider() { kokoro_config_value KOKORO_PROVIDER; }
kokoro_threads() { kokoro_config_value KOKORO_THREADS; }
# Sets KOKORO_OPTION_ARGS: the args for the main ONNX Kokoro ($1 = gpu | cpu).
kokoro_option_args() {
    local provider threads
    provider="$(kokoro_provider)"; threads="$(kokoro_threads)"
    KOKORO_OPTION_ARGS=()
    if [ -n "$provider" ]; then
        KOKORO_OPTION_ARGS+=(--provider "$provider")
    elif [ "$1" = "gpu" ]; then
        KOKORO_OPTION_ARGS+=(--require-gpu)
    fi
    if [ -n "$threads" ] && [ "$threads" != "0" ]; then
        KOKORO_OPTION_ARGS+=(--threads "$threads")
    fi
}

# Start the ONNX Kokoro server detached on port $1 (CPU or GPU, as configured).
start_kokoro_onnx() {
    local port="$1"
    if is_kokoro_onnx_gpu; then
        kokoro_option_args gpu
        start_detached kokoro-onnx-server "$KOKORO_ONNX_PID_FILE" \
            "$SCRIPT_DIR/scripts/kokoro-gpu-start.sh" "$(kokoro_onnx_venv)" --port "$port" \
            --model-dir "$SCRIPT_DIR/models/kokoro" ${KOKORO_OPTION_ARGS[@]+"${KOKORO_OPTION_ARGS[@]}"}
    else
        kokoro_option_args cpu
        start_detached kokoro-onnx-server "$KOKORO_ONNX_PID_FILE" \
            "$VENV_PY" "$SCRIPT_DIR/kokoro-onnx-server.py" --port "$port" \
            --model-dir "$SCRIPT_DIR/models/kokoro" ${KOKORO_OPTION_ARGS[@]+"${KOKORO_OPTION_ARGS[@]}"}
    fi
}

# `status`: the provider/threads settings and how to change them.
status_kokoro_settings() {
    local provider threads
    provider="$(kokoro_provider)"; threads="$(kokoro_threads)"
    echo "  Settings: ${provider:+KOKORO_PROVIDER=$provider}${provider:-KOKORO_PROVIDER unset (as before: $(is_kokoro_onnx_gpu && echo 'CUDA required' || echo "kokoro-onnx's default"))}, ${threads:+KOKORO_THREADS=$threads}${threads:-KOKORO_THREADS unset (onnxruntime default)}"
    echo "  Change: edit ~/.voicemode-local/config (KOKORO_PROVIDER=auto|cuda|cpu|directml|coreml, KOKORO_THREADS=N), then voicemode-switch stop && voicemode-switch start"
}

# Which local proxy ports the *current* config (voicemode.env) actually uses.
configured_local_ports() {
    # A CPU fallback is needed whenever the engine it stands in for is (its own URL may not
    # be routed yet: the routing is written by the next mode switch).
    local kfb="" sfb=""
    is_kokoro_cpu_fallback && kfb="$(kokoro_cpu_fallback_port)"
    is_stt_cpu_fallback && sfb="$(stt_cpu_fallback_port)"
    KOKORO_ONNX_PORT="$(kokoro_onnx_port)" KOKORO_FALLBACK_PORT="$kfb" STT_FALLBACK_PORT="$sfb" \
        python3 - << 'PYEOF'
import os, re
envfile = os.path.expanduser("~/.voicemode/voicemode.env")
text = open(envfile).read() if os.path.exists(envfile) else ""
def val(key):
    # The env file can carry a key more than once (later wins, as with a shell
    # source), so collect every occurrence rather than only the first.
    return ",".join(m.group(1) for m in re.finditer(rf"^{re.escape(key)}=(.*)$", text, re.M))
urls = val("VOICEMODE_TTS_BASE_URLS") + "," + val("VOICEMODE_STT_BASE_URLS")
known = ["8880", "8881", "2022"]
onnx = os.environ.get("KOKORO_ONNX_PORT", "8880")
if onnx not in known:
    known.append(onnx)
# Fall back to the local default if nothing is configured yet.
if not urls.strip(","):
    urls = ",".join(known)
ports = [p for p in known if p in urls]
for fallback, primary in ((os.environ.get("STT_FALLBACK_PORT", ""), "2022"),
                          (os.environ.get("KOKORO_FALLBACK_PORT", ""), onnx)):
    if fallback and primary in ports and fallback not in ports:
        ports.append(fallback)
print(" ".join(ports))
PYEOF
}

# Speech recognition engine (STT_ENGINE in the config): docker (default: Docker
# whisper behind whisper-proxy.py), whisper-cpp (WHISPER_CPP_MODEL), or
# faster-whisper (native, faster-whisper-server.py on 2022). Anything but
# faster-whisper keeps the behaviour from before STT_ENGINE existed.
FASTER_WHISPER_PID_FILE="/tmp/faster-whisper-server.pid"
is_faster_whisper() { [ "$(vm_read_config STT_ENGINE docker)" = "faster-whisper" ]; }
faster_whisper_venv() { vm_read_config FASTER_WHISPER_VENV "$HOME/.voicemode-local/faster-whisper-venv"; }
# Default = what whisper-proxy.py binds (it is started without --host): 0.0.0.0, so
# Windows reaches WSL's 2022 through localhost forwarding just as before.
faster_whisper_host() { vm_read_config FASTER_WHISPER_HOST 0.0.0.0; }

# --- Managed CPU fallbacks for the native GPU engines ---------------------------------
# 2026-11-17: a WSL restart killed the GPU speech recognition (silent for hours) and the GPU
# Kokoro was killed by a test, leaving no local Kokoro. A CPU engine fails independently of
# CUDA, so each GPU engine can have a CPU twin on its own port, after it in the routing:
#   KOKORO_CPU_FALLBACK=true  (needs KOKORO_ONNX_GPU)       kokoro-onnx on the CPU, port
#                             KOKORO_CPU_FALLBACK_PORT (8882), from the GPU venv
#   STT_CPU_FALLBACK=true     (needs STT_ENGINE=faster-whisper) faster-whisper on the CPU,
#                             port STT_CPU_FALLBACK_PORT (2023), model STT_CPU_FALLBACK_MODEL
# Both default off. See docs/native-gpu-tts and docs/native-gpu-stt, "CPU fallback".
KOKORO_CPU_PID_FILE="/tmp/kokoro-cpu-fallback.pid"
STT_CPU_PID_FILE="/tmp/faster-whisper-cpu.pid"
kokoro_cpu_fallback_port() { vm_read_config KOKORO_CPU_FALLBACK_PORT 8882; }
kokoro_cpu_fallback_wanted() { is_kokoro_onnx_gpu && [ "$(vm_read_config KOKORO_CPU_FALLBACK false)" = "true" ]; }
# On the GPU Kokoro's own port it would only collide with it: then it is not run.
is_kokoro_cpu_fallback() { kokoro_cpu_fallback_wanted && [ "$(kokoro_cpu_fallback_port)" != "$(kokoro_onnx_port)" ]; }
stt_cpu_fallback_port() { vm_read_config STT_CPU_FALLBACK_PORT 2023; }
# base, measured 2026-11-17 on a 7.6 s clip, CPU int8, 14 cores, n=3 each: at load ~5 base
# 2.5-5.4 s, small 14.3-16.9 s (only base within 1.5x the clip); at load ~25 base 23.3-29.8 s,
# small 28.0-47.2 s. Idle RSS: base 256 MiB, small 716 MiB. See docs/native-gpu-stt.
stt_cpu_fallback_model() { vm_read_config STT_CPU_FALLBACK_MODEL base; }
is_stt_cpu_fallback() { is_faster_whisper && [ "$(vm_read_config STT_CPU_FALLBACK false)" = "true" ]; }

# The command-line patterns that prove a fallback is this install's own (see own_pids).
kokoro_cpu_own_re() {
    local d; d="$(script_dir_regex)"
    printf '%s' "([^ ]*python[0-9.]* $d/kokoro-onnx-server\\.py|$d/scripts/kokoro-(cpu|gpu)-start\\.sh) .*--port $1( |\$)"
}
stt_cpu_own_re() {
    local d; d="$(script_dir_regex)"
    printf '%s' "([^ ]*python[0-9.]* $d/faster-whisper-server\\.py|$d/scripts/faster-whisper-start\\.sh) .*--port $1( |\$)"
}

start_kokoro_cpu_fallback() {
    # KOKORO_THREADS applies here too; KOKORO_PROVIDER never does (always the CPU).
    local threads; threads="$(kokoro_threads)"
    local extra=()
    if [ -n "$threads" ] && [ "$threads" != "0" ]; then extra=(--threads "$threads"); fi
    start_detached kokoro-cpu-fallback "$KOKORO_CPU_PID_FILE" \
        "$SCRIPT_DIR/scripts/kokoro-cpu-start.sh" "$(kokoro_onnx_venv)" \
        --port "$(kokoro_cpu_fallback_port)" --model-dir "$SCRIPT_DIR/models/kokoro" --no-download \
        ${extra[@]+"${extra[@]}"}
}

start_stt_cpu_fallback() {
    start_detached faster-whisper-cpu "$STT_CPU_PID_FILE" \
        "$SCRIPT_DIR/scripts/faster-whisper-start.sh" "$(faster_whisper_venv)" \
        --host "$(faster_whisper_host)" --port "$(stt_cpu_fallback_port)" \
        --model "$(stt_cpu_fallback_model)" --device cpu --compute-type int8
}

# Stop a fallback only if its pid is provably this install's own; a stale pid file whose pid
# now belongs to something else is removed, not acted on.
stop_cpu_fallback() {   # $1 = label, $2 = pid file, $3 = own-process regex
    local pids
    pids="$(own_pids "$2" "$3")" || true
    if [ -n "$pids" ] && stop_port_holders "$pids"; then
        ok "$1 stopped"
    elif [ -n "$pids" ]; then
        warn "$1 (PID $pids) did not stop"
    else
        warn "$1 was not running"
    fi
    rm -f "$2"
}

healthy() {
    # $1 = port. True if the local service answers /health or /v1/models.
    curl -sf --max-time 2 "http://127.0.0.1:$1/health"     > /dev/null 2>&1 && return 0
    curl -sf --max-time 2 "http://127.0.0.1:$1/v1/models"  > /dev/null 2>&1 && return 0
    return 1
}

# Start a proxy DETACHED (own session via setsid) so it outlives the Claude
# session / MCP wrapper that launched it. Idempotent via PID file.
start_detached() {
    local label="$1" pidfile="$2"; shift 2
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return 0; fi
    if command -v setsid > /dev/null 2>&1; then
        setsid nohup "$@" >> "/tmp/${label}.log" 2>&1 < /dev/null &
    else
        # macOS has no setsid(1); do the same via os.setsid() + exec (keeps the PID).
        nohup python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
            "$@" >> "/tmp/${label}.log" 2>&1 < /dev/null &
    fi
    echo $! > "$pidfile"
}

# --- Who holds a port: "it answers" is not "it is the configured engine" ----------
# 2026-11-17: STT_ENGINE=faster-whisper was configured, but the old whisper-proxy had taken
# port 2022 (the ~/.bashrc autostart) and its /health answered 200 over a dead backend, so
# `ensure` saw a healthy port and never started the engine. For a NATIVE engine the port is
# healthy only if /health names that engine: faster-whisper on 2022 ("engine"), and with
# KOKORO_ONNX_GPU=true the Kokoro on 8880 ("provider" CUDAExecutionProvider). A holder is
# stopped only when its pid file or command line proves it is voicemode's own, by exact pid.
port_health_body() { curl -s --max-time 2 "http://127.0.0.1:$1/health" 2>/dev/null; }

json_field() {   # $1 = JSON text, $2 = key; prints the value, empty if absent/null/not JSON
    printf '%s' "$1" | python3 -c 'import json, sys
try:
    v = json.load(sys.stdin).get(sys.argv[1])
except Exception:
    v = None
print("" if v is None else v)' "$2" 2>/dev/null
}

# Live pids that are voicemode's own, by exact pid. The pid file's pid wins when its command
# line matches the extended regex $2 (then it is the only pid returned). Otherwise the
# fallback is every process OF THE CURRENT USER whose command line matches $2; callers build
# $2 around this install's own "$SCRIPT_DIR", so a lookalike running another path (another
# checkout, a test's fake) never matches. One `ps`, no per-pid loop.
own_pids() {   # $1 = pid file, $2 = regex over the command line
    local pid line
    pid="$(cat "$1" 2>/dev/null)"
    case "$pid" in ''|*[!0-9]*) pid="" ;; esac
    if [ -n "$pid" ]; then
        line="$(ps -u "$(id -u)" -ww -p "$pid" -o pid=,args= 2>/dev/null)"
        if printf '%s\n' "$line" | grep -Eq "^ *[0-9]+ $2"; then echo "$pid"; return 0; fi
    fi
    ps -u "$(id -u)" -ww -o pid=,args= 2>/dev/null | grep -E "^ *[0-9]+ $2" | awk '{print $1}' | sort -un | tr '\n' ' ' | sed 's/ $//'
}

# $SCRIPT_DIR with every regex metacharacter escaped, for the anchored patterns below.
script_dir_regex() { printf '%s' "$SCRIPT_DIR" | sed 's/[][\.*^$(){}?+|/]/\\&/g'; }

# Sets PORT_HOLDER (what holds the port), PORT_PIDS (its provable own pids) and PORT_EXPECT,
# and returns 0 when $1 is held by something other than the configured native engine;
# returns 1 when the port is fine (free, the right engine, or no native engine configured).
PORT_HOLDER=""; PORT_PIDS=""; PORT_EXPECT=""
port_identity_mismatch() {
    local port="$1" body field d
    PORT_HOLDER=""; PORT_PIDS=""; PORT_EXPECT=""
    if [ "$port" = "2022" ] && is_faster_whisper; then
        PORT_EXPECT="the configured faster-whisper engine"
        body="$(port_health_body 2022)"
        if [ -z "$body" ] && ! healthy 2022; then return 1; fi   # nothing answers
        [ "$(json_field "$body" engine)" = "faster-whisper" ] && return 1
        PORT_PIDS="$(own_pids "$PROXY_PID_FILE" "[^ ]*python[0-9.]* $(script_dir_regex)/whisper-proxy\\.py --port 2022( |\$)")"
        PORT_HOLDER="whisper-proxy"
    elif [ "$port" = "8880" ] && is_kokoro_onnx_gpu && [ "$(kokoro_onnx_port)" = "8880" ]; then
        PORT_EXPECT="the configured GPU Kokoro (CUDAExecutionProvider)"
        body="$(port_health_body 8880)"
        if [ -z "$body" ] && ! healthy 8880; then return 1; fi
        field="$(json_field "$body" provider)"
        [ "$field" = "CUDAExecutionProvider" ] && return 1
        d="$(script_dir_regex)"
        PORT_PIDS="$(own_pids "$KOKORO_ONNX_PID_FILE" "([^ ]*python[0-9.]* $d/kokoro-onnx-server\\.py|$d/scripts/kokoro-gpu-start\\.sh) .*--port 8880( |\$)")"
        # No provider reported by our own server = its model is still loading: leave it be.
        if [ -z "$field" ] && [ -n "$PORT_PIDS" ]; then return 1; fi
        PORT_HOLDER="kokoro-onnx-server${field:+ on $field}"
    elif is_kokoro_cpu_fallback && [ "$port" = "$(kokoro_cpu_fallback_port)" ]; then
        PORT_EXPECT="the configured Kokoro CPU fallback (CPUExecutionProvider)"
        body="$(port_health_body "$port")" || true
        if [ -z "$body" ] && ! healthy "$port"; then return 1; fi
        field="$(json_field "$body" provider)"
        [ "$field" = "CPUExecutionProvider" ] && return 1
        PORT_PIDS="$(own_pids "$KOKORO_CPU_PID_FILE" "$(kokoro_cpu_own_re "$port")")"
        if [ -z "$field" ] && [ -n "$PORT_PIDS" ]; then return 1; fi   # ours, still loading
        PORT_HOLDER="kokoro-onnx-server${field:+ on $field}"
    elif is_stt_cpu_fallback && [ "$port" = "$(stt_cpu_fallback_port)" ]; then
        PORT_EXPECT="the configured faster-whisper CPU fallback"
        body="$(port_health_body "$port")" || true
        if [ -z "$body" ] && ! healthy "$port"; then return 1; fi
        field="$(json_field "$body" device)"
        [ "$(json_field "$body" engine)" = "faster-whisper" ] && [ "$field" = "cpu" ] && return 1
        PORT_PIDS="$(own_pids "$STT_CPU_PID_FILE" "$(stt_cpu_own_re "$port")")"
        # Ours on the CPU with its model still loading: /health is 503 {"status": "loading"}.
        if [ "$(json_field "$body" status)" = "loading" ] && [ "$field" = "cpu" ] && [ -n "$PORT_PIDS" ]; then
            return 1
        fi
        PORT_HOLDER="faster-whisper${field:+ on $field}"
    else
        return 1
    fi
    [ -n "$PORT_PIDS" ] || PORT_HOLDER="an unidentified service"
    return 0
}

# Stop the provable own holders by exact pid and wait for them to go. Fails if one stays.
stop_port_holders() {
    local pid n
    for pid in $1; do kill "$pid" 2>/dev/null || true; done
    for pid in $1; do
        n=0
        while kill -0 "$pid" 2>/dev/null; do
            n=$((n + 1)); [ "$n" -gt 50 ] && return 1
            sleep 0.1
        done
    done
    return 0
}

# Ensure exactly the proxies the current config needs are up. Started detached,
# so they survive the launching session and stay up for the others. Idempotent
# and serialized across concurrent session starts via a lock.
cmd_ensure() {
    local quiet="${1:-}" rc=0
    local onnx_port; onnx_port="$(kokoro_onnx_port)"
    local kfb_port="-" sfb_port="-"   # "-" never equals a port: no fallback configured
    is_kokoro_cpu_fallback && kfb_port="$(kokoro_cpu_fallback_port)"
    is_stt_cpu_fallback && sfb_port="$(stt_cpu_fallback_port)"
    exec 9>"/tmp/voicemode-ensure.lock"
    flock 9 2>/dev/null || true
    if kokoro_cpu_fallback_wanted && ! is_kokoro_cpu_fallback; then
        echo "Kokoro CPU fallback not started: KOKORO_CPU_FALLBACK_PORT ($(kokoro_cpu_fallback_port)) is the GPU Kokoro's own port (KOKORO_ONNX_PORT); set another" >&2
    fi
    for port in $(configured_local_ports); do
        if port_identity_mismatch "$port"; then
            if [ -z "$PORT_PIDS" ]; then
                echo "$port is held by $PORT_HOLDER, not $PORT_EXPECT; not stopping it (cannot prove it is voicemode's own)" >&2
                rc=1; continue
            fi
            echo "$port is held by $PORT_HOLDER (PID $PORT_PIDS), not $PORT_EXPECT; stopping it" >&2
            if ! stop_port_holders "$PORT_PIDS"; then
                echo "$port: PID $PORT_PIDS did not stop; not starting $PORT_EXPECT" >&2
                rc=1; continue
            fi
        elif healthy "$port"; then continue; fi
        case "$port" in
            8880)
                # ONNX takes 8880 only when configured to replace Docker Kokoro.
                # Otherwise a session starting before Docker is up would claim
                # the port, keep it after Docker arrives, and (via the shared
                # PID file) stop the real ONNX fallback port from starting.
                if is_kokoro_onnx && [ "$onnx_port" = "8880" ]; then
                    start_kokoro_onnx 8880
                else
                    docker_compose_cmd up -d > /dev/null 2>&1 || true
                fi
                if is_kokoro_onnx_gpu && [ "$onnx_port" = "8880" ]; then
                    [ -n "$quiet" ] || echo "  ensured Kokoro ONNX on the GPU (8880)"
                else
                    [ -n "$quiet" ] || echo "  ensured Kokoro (8880)"
                fi ;;
            8881)
                start_detached piper-proxy /tmp/piper-proxy.pid \
                    "$VENV_PY" "$SCRIPT_DIR/piper-proxy.py" --port 8881 \
                    --voices-file "$SCRIPT_DIR/voices/piper-voices.json" \
                    --models-dir "$SCRIPT_DIR/models/piper"
                [ -n "$quiet" ] || echo "  ensured Piper (8881)" ;;
            2022)
                local wcpp_model; wcpp_model="$(vm_read_config WHISPER_CPP_MODEL)"
                if is_faster_whisper; then
                    # Native faster-whisper (GPU): serves the OpenAI path itself, so
                    # no proxy and no Docker whisper. The wrapper sets the CUDA
                    # library path before the server starts. See docs/native-gpu-stt.
                    start_detached faster-whisper-server "$FASTER_WHISPER_PID_FILE" \
                        "$SCRIPT_DIR/scripts/faster-whisper-start.sh" "$(faster_whisper_venv)" \
                        --host "$(faster_whisper_host)" \
                        --port 2022 --model "$(vm_read_config FASTER_WHISPER_MODEL small)"
                    [ -n "$quiet" ] || echo "  ensured faster-whisper server (2022)"
                elif [ -n "$wcpp_model" ] && command -v whisper-server > /dev/null 2>&1; then
                    # Native whisper.cpp (e.g. macOS + Metal): serves the
                    # OpenAI-compatible path itself, so no proxy / Docker backend.
                    start_detached whisper-server /tmp/whisper-server.pid \
                        whisper-server --host 127.0.0.1 --port 2022 -m "$wcpp_model" \
                        -l auto --convert --inference-path /v1/audio/transcriptions
                    [ -n "$quiet" ] || echo "  ensured whisper.cpp server (2022)"
                else
                    start_detached whisper-proxy /tmp/whisper-proxy.pid \
                        python3 "$SCRIPT_DIR/whisper-proxy.py" --port 2022 \
                        --whisper-url http://127.0.0.1:9000
                    [ -n "$quiet" ] || echo "  ensured Whisper proxy (2022)"
                fi ;;
            "$kfb_port")
                start_kokoro_cpu_fallback
                [ -n "$quiet" ] || echo "  ensured Kokoro CPU fallback ($port)" ;;
            "$sfb_port")
                start_stt_cpu_fallback
                [ -n "$quiet" ] || echo "  ensured faster-whisper CPU fallback ($port)" ;;
            "$onnx_port")
                # Only reached when KOKORO_ONNX_PORT is NOT 8880 — i.e. ONNX is
                # running alongside the Docker Kokoro rather than instead of it.
                start_kokoro_onnx "$onnx_port"
                if is_kokoro_onnx_gpu; then
                    [ -n "$quiet" ] || echo "  ensured Kokoro ONNX on the GPU ($onnx_port)"
                else
                    [ -n "$quiet" ] || echo "  ensured Kokoro ONNX ($onnx_port)"
                fi ;;
        esac
    done
    expose_barge_tool
    # Voice barge-in trigger (opt-in; one per machine, shared by all sessions).
    if voice_barge_enabled && [ -f "$SILERO_MODEL" ]; then
        start_detached voice-barge /tmp/voice-barge.pid \
            "$VENV_PY" -m voice_mode.voice_barge "$SILERO_MODEL"
        [ -n "$quiet" ] || echo "  ensured voice barge-in trigger"
    fi
    flock -u 9 2>/dev/null || true
    return $rc
}

# --- Voice barge-in: stop TTS when the user talks over it --------------------
voice_barge_enabled() {
    local env_file="$HOME/.voicemode/voicemode.env" value=""
    [ -f "$env_file" ] && value="$(sed -n 's/^VOICEMODE_VOICE_BARGE=//p' "$env_file" | tail -1)"
    [ "$value" = "true" ] || [ "$value" = "auto" ]
}

# A tool whitelist would hide the voice_barge MCP tool. Never create a whitelist:
# without one, every tool already loads.
expose_barge_tool() { with_env_lock _expose_barge_tool; }
_expose_barge_tool() {
    local env_file="$HOME/.voicemode/voicemode.env"
    [ -f "$env_file" ] || return 0
    grep -q '^VOICEMODE_TOOLS_ENABLED=' "$env_file" || return 0
    grep -q '^VOICEMODE_TOOLS_ENABLED=.*voice_barge_tool' "$env_file" && return 0
    sed -i.bak 's/^\(VOICEMODE_TOOLS_ENABLED=.*\)$/\1,voice_barge_tool/' "$env_file" && rm -f "$env_file.bak"
}

set_voice_barge() { with_env_lock _set_voice_barge "$@"; }
_set_voice_barge() {
    local env_file="$HOME/.voicemode/voicemode.env"
    mkdir -p "$(dirname "$env_file")"; touch "$env_file"
    sed -i.bak '/^VOICEMODE_VOICE_BARGE=/d' "$env_file" && rm -f "$env_file.bak"
    echo "VOICEMODE_VOICE_BARGE=$1" >> "$env_file"
}

stop_voice_barge() {
    local pidfile=/tmp/voice-barge.pid
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        kill "$(cat "$pidfile")" 2>/dev/null || true
    fi
    rm -f "$pidfile"
}

# sha256 of a file: sha256sum, else shasum -a 256 (older macOS has only the latter)
sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

fetch_silero_model() {
    [ -f "$SILERO_MODEL" ] && [ "$(sha256_of "$SILERO_MODEL")" = "$SILERO_SHA256" ] && return 0
    mkdir -p "$(dirname "$SILERO_MODEL")"
    local tmp="$SILERO_MODEL.download"
    curl -fsSL --max-time 120 -o "$tmp" "$SILERO_URL" || { rm -f "$tmp"; fail "Could not download the Silero model"; return 1; }
    if [ "$(sha256_of "$tmp")" != "$SILERO_SHA256" ]; then
        rm -f "$tmp"; fail "Silero model failed its checksum; not installed"; return 1
    fi
    mv -f "$tmp" "$SILERO_MODEL"
}

cmd_barge() {
    case "${1:-status}" in
        on|auto)
            fetch_silero_model || return 1
            set_voice_barge "$([ "$1" = auto ] && echo auto || echo true)"
            # The trigger's barge_in travels over the control channel (upstream default: off).
            # `barge off` leaves it on: the pill and push-to-talk use it too.
            set_env_value VOICEMODE_CONTROL_CHANNEL_ENABLED true
            stop_voice_barge
            cmd_ensure --quiet
            if [ "$1" = auto ]; then ok "Voice barge-in auto: listens only while sound plays to headphones. New voice sessions need /mcp reconnect to pick up the patch."
            else ok "Voice barge-in on. New voice sessions need /mcp reconnect to pick up the patch."; fi
            ;;
        off)
            set_voice_barge false
            stop_voice_barge
            ok "Voice barge-in off"
            ;;
        status)
            if [ "$(env_value VOICEMODE_VOICE_BARGE)" = "auto" ]; then echo "Voice barge-in: auto (listens only on headphones)"
            elif voice_barge_enabled; then echo "Voice barge-in: enabled"; else echo "Voice barge-in: disabled"; fi
            if [ "$(env_value VOICEMODE_CONTROL_CHANNEL_ENABLED)" = "true" ]; then
                echo "Control channel: enabled"
            else
                echo "Control channel: disabled (barge-in cannot cut playback without it)"
            fi
            if [ -f /tmp/voice-barge.pid ] && kill -0 "$(cat /tmp/voice-barge.pid)" 2>/dev/null; then
                echo "Trigger: running (PID $(cat /tmp/voice-barge.pid), log /tmp/voice-barge.log)"
            else
                echo "Trigger: not running"
            fi
            # macOS: the output route and the mic it gets (echo cancellation on the speakers).
            # The module prints it as its second line; the first (on/off) is shown above.
            if [ "$(uname -s)" = "Darwin" ]; then
                "$VENV_PY" -m voice_mode.voice_barge status 2>/dev/null | sed -n '2,$p'
            fi
            ;;
        *) echo "usage: voicemode-switch barge [on|off|auto|status]"; return 2 ;;
    esac
}

# --- Voice pill: the small on-screen status window ----------------------------
# Anchored on the interpreter: an editor or a shell whose command line merely names
# the file must not match, as `pkill -f` matches the whole line.
PILL_BACKEND_RE='^[^ ]*python[^ ]* (-m voice_mode\.voice_pill|[^ ]*/voice_pill\.py)( |$)'

env_value() { sed -n "s/^$1=//p" "$HOME/.voicemode/voicemode.env" 2>/dev/null | tail -1; }

set_env_value() { with_env_lock _set_env_value "$@"; }
_set_env_value() {
    local env_file="$HOME/.voicemode/voicemode.env"
    mkdir -p "$(dirname "$env_file")"; touch "$env_file"
    # Replace the key where it is (comments and order stay); a new key goes at the end.
    local tmp; tmp="$(mktemp "$env_file.XXXXXX")" || return 1
    KEY="$1" VAL="$2" awk '
        BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VAL"]; done = 0 }
        index($0, k "=") == 1 { if (!done) { print k "=" v; done = 1 }; next }
        { print }
        END { if (!done) print k "=" v }' "$env_file" > "$tmp" \
        && cat "$tmp" > "$env_file"
    local rc=$?
    rm -f "$tmp"
    return $rc
}

# macOS: pywebview lives in its own venv, so the main venv gains no dependency.
PILL_VENV="$HOME/.voicemode/pill-venv"
# The interpreter may re-exec as .../Python.app/Contents/MacOS/Python: match either case.
PILL_WINDOW_RE='^[^ ]*[Pp]ython[^ ]* ([^ ]+ )*[^ ]*/voice_pill_mac\.py( |$)'
PILL_MAC_PINS="pywebview==6.2.1 pyobjc-core==13.0 pyobjc-framework-Cocoa==13.0 pyobjc-framework-Quartz==13.0 pyobjc-framework-WebKit==13.0 pyobjc-framework-Security==13.0 pyobjc-framework-UniformTypeIdentifiers==13.0"

find_pill_python() {
    local c
    for c in python3.13 python3.12 python3.11 python3.10 python3; do
        c="$(command -v "$c" 2>/dev/null)" || continue
        "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null && { echo "$c"; return 0; }
    done
    return 1
}

setup_pill_venv() {
    # The pin list is the marker: a changed list reinstalls, an unchanged one does nothing.
    if [ "$(cat "$PILL_VENV/.pins" 2>/dev/null)" = "$PILL_MAC_PINS" ] && [ -x "$PILL_VENV/bin/python" ]; then return 0; fi
    echo "  Setting up the pill venv ($PILL_VENV)..."
    local py; py="$(find_pill_python)" || { fail "The pill venv needs Python 3.10 or newer (pyobjc 13). Install one (brew install python@3.12) and retry"; return 1; }
    { "$py" -m venv "$PILL_VENV" && "$PILL_VENV/bin/python" -m pip install --quiet $PILL_MAC_PINS; } \
        || { fail "Could not set up the pill venv"; return 1; }
    printf '%s' "$PILL_MAC_PINS" > "$PILL_VENV/.pins"
}

# The window takes its own single-instance lock, so a second `on` is harmless. Waits
# for early failures, as the Windows path does.
start_pill_window_mac() {
    setup_pill_venv || return 1
    mkdir -p "$HOME/.voicemode/logs"
    local log="$HOME/.voicemode/logs/pill-window.log" pid
    nohup "$PILL_VENV/bin/python" "$SCRIPT_DIR/patches/voice_pill_mac.py" >> "$log" 2>&1 < /dev/null &
    pid=$!; disown 2>/dev/null || true
    sleep 3
    if kill -0 "$pid" 2>/dev/null; then return 0; fi
    if wait "$pid" 2>/dev/null; then PILL_ALREADY=1; else fail "The pill window did not stay up. See $log"; return 1; fi
}

# Windows is the only other platform whose window this script can open. The window takes
# its own single-instance lock, so a second `on` is harmless. Waits for the window's
# early failures: a broken venv shows up within seconds, as exit 1.
start_pill_window() {
    [ "$(uname -s)" = "Darwin" ] && { start_pill_window_mac; return; }
    [ -n "${WSL_DISTRO_NAME:-}" ] && command -v powershell.exe >/dev/null 2>&1 || return 0
    local script result; script="$(wslpath -w "$SCRIPT_DIR/pill-windows.ps1")"
    result="$(powershell.exe -NoProfile -Command "\$p=Start-Process powershell.exe -PassThru -WindowStyle Hidden -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','\"$script\"'; \$h=\$p.Handle; if (\$p.WaitForExit(15000)) { \$p.ExitCode } else { 'running' }" 2>/dev/null | tr -d '\r' | tail -1)" || result=""
    case "$result" in
        running) ;;
        0) PILL_ALREADY=1 ;;
        "") warn "Could not confirm the pill window started; run pill-windows.ps1 by hand" ;;
        *) fail "The pill window did not stay up (exit $result). See %LOCALAPPDATA%\\\\voicemode-local\\\\pill-window.log"; return 1 ;;
    esac
}

# Stops a window that has no backend for pkill to find.
signal_pill_window() {
    [ -n "${WSL_DISTRO_NAME:-}" ] && command -v powershell.exe >/dev/null 2>&1 || return 0
    powershell.exe -NoProfile -Command "\$e=\$null; if ([Threading.EventWaitHandle]::TryOpenExisting('Local\\VoiceModePillStop',[ref]\$e)) { [void]\$e.Set() }" >/dev/null 2>&1 || true
}

cmd_pill() {
    case "${1:-status}" in
        on)
            set_env_value VOICEMODE_PILL true
            set_env_value VOICEMODE_CONTROL_CHANNEL_ENABLED true  # upstream's default is off
            start_pill_window || return 1
            if [ -n "${PILL_ALREADY:-}" ]; then ok "Voice pill on (the window was already running). Voice sessions already running need /mcp reconnect."
            else ok "Voice pill on. Voice sessions already running need /mcp reconnect."; fi
            ;;
        off)
            set_env_value VOICEMODE_PILL false
            signal_pill_window
            # Where nothing can be signalled, the window sees the flag when its backend exits.
            # On macOS the window goes first, so it cannot restart the backend; its exit ends the backend too.
            pkill -f "$PILL_WINDOW_RE" 2>/dev/null || true
            pkill -f "$PILL_BACKEND_RE" 2>/dev/null || true
            ok "Voice pill off"
            ;;
        ensure)
            # Per session start (voicemode-mcp, WSL): open the window if the pill is on. Writes
            # no setting; the window's single-instance lock makes a repeat harmless.
            [ "$(env_value VOICEMODE_PILL)" = "true" ] || return 0
            start_pill_window || return 1
            ;;
        status)
            if [ "$(env_value VOICEMODE_PILL)" = "true" ]; then echo "Voice pill: enabled"; else echo "Voice pill: disabled"; fi
            if [ "$(env_value VOICEMODE_CONTROL_CHANNEL_ENABLED)" = "true" ]; then echo "Control channel: enabled"; else echo "Control channel: disabled"; fi
            if pgrep -f "$PILL_BACKEND_RE" >/dev/null 2>&1; then echo "Backend: running"; else echo "Backend: not running"; fi
            ;;
        *) echo "usage: voicemode-switch pill [on|off|status|ensure]"; return 2 ;;
    esac
}

# Structured health probe of the configured endpoints (exit 0 iff all up).
cmd_health() {
    local all_up=0
    echo "=== VoiceMode health (configured local proxies) ==="
    local ports; ports="$(configured_local_ports)"
    [ -n "$ports" ] || { echo "  (no local proxies configured)"; return 0; }
    local kfb_port="-" sfb_port="-"
    is_kokoro_cpu_fallback && kfb_port="$(kokoro_cpu_fallback_port)"
    is_stt_cpu_fallback && sfb_port="$(stt_cpu_fallback_port)"
    for port in $ports; do
        case "$port" in
            8880) n="Kokoro TTS";;
            8881) n="Piper TTS";;
            2022) n="Whisper STT";;
            "$kfb_port") n="Kokoro CPU fallback";;
            "$sfb_port") n="faster-whisper CPU fallback";;
            "$(kokoro_onnx_port)") n="Kokoro ONNX TTS";;
            *) n="port $port";;
        esac
        if healthy "$port"; then ok "$n ($port) up"; else fail "$n ($port) DOWN"; all_up=1; fi
    done
    return $all_up
}

# `start` with native GPU Kokoro: the server through the GPU wrapper, then only the
# containers still in use. On 8880 it replaces the Docker Kokoro, so that container is
# not started (and is stopped if it holds the port); the Docker whisper only when
# STT_ENGINE is docker; Piper when PIPER_ENABLED=true.
start_kokoro_gpu_and_containers() {
    local onnx_port; onnx_port="$(kokoro_onnx_port)"
    echo ""
    echo "Starting Kokoro ONNX server (native GPU, port $onnx_port)..."
    if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
        warn "Kokoro ONNX server already running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
    else
        if [ "$onnx_port" = "8880" ] && healthy 8880; then
            echo "  Port 8880 answers: stopping the Docker kokoro so the native server can take it"
            docker_compose_cmd stop kokoro 2>&1 | sed 's/^/  /' || true
        fi
        start_kokoro_onnx "$onnx_port"
        sleep 2
        if kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            ok "Kokoro ONNX server started (PID $(cat "$KOKORO_ONNX_PID_FILE")); with --require-gpu it exits if CUDA does not load (log: /tmp/kokoro-onnx-server.log)"
        else
            fail "Kokoro ONNX server failed - check /tmp/kokoro-onnx-server.log"
        fi
    fi

    echo ""
    local services=()
    if [ "$onnx_port" = "8880" ]; then
        echo "Speech output is native GPU Kokoro on 8880: not starting the Docker kokoro"
    else
        services+=(kokoro)
    fi
    if [ "$(vm_read_config STT_ENGINE docker)" = "docker" ]; then services+=(whisper); fi
    if [ "$(vm_read_config PIPER_ENABLED false)" = "true" ]; then services+=(piper); fi
    if [ ${#services[@]} -eq 0 ]; then
        echo "No Docker containers needed"
    else
        echo "Starting Docker containers (${services[*]})..."
        docker_compose_cmd up -d "${services[@]}" 2>&1 | sed 's/^/  /'
    fi
}

# `start` with the CPU Kokoro ONNX on 8880: who holds 8880 decides what happens to it. This
# replaced a kill of every pid `lsof -ti:8880` listed, whatever it was.
#   this install's own earlier kokoro-onnx-server   stopped by exact pid (own_pids)
#   a Docker container publishing 8880 whose image  `docker stop <its name>`
#   name contains "kokoro"
#   anything else                                   one line naming it; returns 1, kills nothing
free_8880_for_cpu_onnx() {
    local pids own name image other="" first
    pids="$(lsof -ti:8880 2>/dev/null | tr '\n' ' ' | sed 's/ $//')" || pids=""
    if [ -z "$pids" ] && ! healthy 8880; then return 0; fi
    own="$(own_pids "$KOKORO_ONNX_PID_FILE" \
        "([^ ]*python[0-9.]* $(script_dir_regex)/kokoro-onnx-server\\.py|$(script_dir_regex)/scripts/kokoro-(gpu|cpu)-start\\.sh) .*--port 8880( |\$)")" || own=""
    if [ -n "$own" ]; then
        echo "  8880 is held by this install's earlier kokoro-onnx-server (PID $own): stopping it"
        stop_port_holders "$own" && return 0
        fail "8880: PID $own did not stop; not starting Kokoro ONNX"
        return 1
    fi
    if command -v docker > /dev/null 2>&1; then
        while IFS=$'\t' read -r name image; do
            [ -n "$name" ] || continue
            case "$image" in
                *kokoro*)
                    echo "  8880 is held by the Docker container $name ($image): stopping it"
                    if docker stop "$name" > /dev/null 2>&1; then return 0; fi
                    fail "8880: docker stop $name failed; not starting Kokoro ONNX"
                    return 1 ;;
            esac
            other="the Docker container $name ($image)"
        done < <(docker ps --filter publish=8880 --format '{{.Names}}{{"\t"}}{{.Image}}' 2>/dev/null || true)
    fi
    if [ -z "$other" ] && [ -n "$pids" ]; then
        first="${pids%% *}"
        other="PID $pids ($(ps -o comm= -p "$first" 2>/dev/null || echo unknown))"
    fi
    fail "8880 is held by ${other:-an unidentified service}, not by voicemode's own Kokoro; not stopping it (free the port, or set KOKORO_ONNX_PORT)"
    return 1
}

# `start`: the configured CPU fallbacks, each after the GPU engine it stands in for.
start_cpu_fallbacks_verbose() {
    local port
    if kokoro_cpu_fallback_wanted && ! is_kokoro_cpu_fallback; then
        echo ""
        fail "Kokoro CPU fallback not started: KOKORO_CPU_FALLBACK_PORT ($(kokoro_cpu_fallback_port)) is the GPU Kokoro's own port (KOKORO_ONNX_PORT)"
    fi
    if is_kokoro_cpu_fallback; then
        port="$(kokoro_cpu_fallback_port)"
        echo ""
        echo "Starting Kokoro CPU fallback (port $port)..."
        if [ -f "$KOKORO_CPU_PID_FILE" ] && kill -0 "$(cat "$KOKORO_CPU_PID_FILE")" 2>/dev/null; then
            warn "Kokoro CPU fallback already running (PID $(cat "$KOKORO_CPU_PID_FILE"))"
        else
            start_kokoro_cpu_fallback
            sleep 1
            if kill -0 "$(cat "$KOKORO_CPU_PID_FILE")" 2>/dev/null; then
                ok "Kokoro CPU fallback started (PID $(cat "$KOKORO_CPU_PID_FILE")); it answers once its model is loaded"
            else
                fail "Kokoro CPU fallback failed to start - check /tmp/kokoro-cpu-fallback.log"
            fi
        fi
    fi
    if is_stt_cpu_fallback; then
        port="$(stt_cpu_fallback_port)"
        echo ""
        echo "Starting faster-whisper CPU fallback (port $port, model $(stt_cpu_fallback_model))..."
        if [ -f "$STT_CPU_PID_FILE" ] && kill -0 "$(cat "$STT_CPU_PID_FILE")" 2>/dev/null; then
            warn "faster-whisper CPU fallback already running (PID $(cat "$STT_CPU_PID_FILE"))"
        else
            start_stt_cpu_fallback
            sleep 1
            if kill -0 "$(cat "$STT_CPU_PID_FILE")" 2>/dev/null; then
                ok "faster-whisper CPU fallback started (PID $(cat "$STT_CPU_PID_FILE")); /health turns 200 once the model is loaded"
            else
                fail "faster-whisper CPU fallback failed to start - check /tmp/faster-whisper-cpu.log"
            fi
        fi
    fi
}

cmd_start() {
    echo "=== Starting Local VoiceMode Services ==="

    if is_kokoro_onnx_gpu; then
        start_kokoro_gpu_and_containers
    elif is_kokoro_onnx; then
        ONNX_PORT="$(kokoro_onnx_port)"
        echo ""
        echo "Starting Kokoro ONNX server (native, port $ONNX_PORT)..."
        KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
        if [ -f "$KOKORO_ONNX_PID_FILE" ] && kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
            warn "Kokoro ONNX server already running (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
        else
            # Only clear the port when ONNX is taking 8880 FROM the Docker
            # Kokoro. On a separate port (8882) there is nothing to displace,
            # and killing whatever answers there would be gratuitous.
            if [ "$ONNX_PORT" = "8880" ] && ! free_8880_for_cpu_onnx; then
                exit 1
            fi
            kokoro_option_args cpu
            nohup "$VENV_PY" "$SCRIPT_DIR/kokoro-onnx-server.py" --port "$ONNX_PORT" \
                --model-dir "$SCRIPT_DIR/models/kokoro" ${KOKORO_OPTION_ARGS[@]+"${KOKORO_OPTION_ARGS[@]}"} \
                > /tmp/kokoro-onnx-server.log 2>&1 &
            echo $! > "$KOKORO_ONNX_PID_FILE"
            sleep 2
            if kill -0 "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null; then
                ok "Kokoro ONNX server started (PID $(cat "$KOKORO_ONNX_PID_FILE"))"
            else
                fail "Kokoro ONNX server failed - check /tmp/kokoro-onnx-server.log"
            fi
        fi
    else
        echo ""
        local stt_engine; stt_engine="$(vm_read_config STT_ENGINE docker)"
        if [ "$stt_engine" = "docker" ]; then
            echo "Starting Docker containers..."
            docker_compose_cmd up -d 2>&1 | sed 's/^/  /'
        else
            # Native speech recognition: the Docker whisper would only take memory.
            local services=(kokoro)
            [ "$(vm_read_config PIPER_ENABLED false)" = "true" ] && services+=(piper)
            echo "Starting Docker containers (${services[*]})..."
            echo "  Speech recognition is native ($stt_engine): not starting the Docker whisper"
            docker_compose_cmd up -d "${services[@]}" 2>&1 | sed 's/^/  /'
        fi
    fi

    echo ""
    if is_faster_whisper; then
        echo "Starting faster-whisper server (native STT, port 2022)..."
        start_detached faster-whisper-server "$FASTER_WHISPER_PID_FILE" \
            "$SCRIPT_DIR/scripts/faster-whisper-start.sh" "$(faster_whisper_venv)" \
            --host "$(faster_whisper_host)" \
            --port 2022 --model "$(vm_read_config FASTER_WHISPER_MODEL small)"
        sleep 1
        if kill -0 "$(cat "$FASTER_WHISPER_PID_FILE")" 2>/dev/null; then
            ok "faster-whisper server started (PID $(cat "$FASTER_WHISPER_PID_FILE")); /health turns 200 once the model is loaded"
        else
            fail "faster-whisper server failed to start — check /tmp/faster-whisper-server.log"
        fi
    elif [ "$(vm_read_config STT_ENGINE docker)" = "whisper-cpp" ]; then
        echo "Starting whisper.cpp server (native STT, port 2022)..."
        local wcpp_model; wcpp_model="$(vm_read_config WHISPER_CPP_MODEL)"
        if [ -n "$wcpp_model" ] && command -v whisper-server > /dev/null 2>&1; then
            # Same command as `ensure`.
            start_detached whisper-server /tmp/whisper-server.pid \
                whisper-server --host 127.0.0.1 --port 2022 -m "$wcpp_model" \
                -l auto --convert --inference-path /v1/audio/transcriptions
            ok "whisper.cpp server started (PID $(cat /tmp/whisper-server.pid))"
        else
            fail "STT_ENGINE=whisper-cpp needs WHISPER_CPP_MODEL in the config and whisper-server on PATH"
        fi
    else
        echo "Starting Whisper proxy..."
        if [ -f "$PROXY_PID_FILE" ] && kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
            warn "Proxy already running (PID $(cat "$PROXY_PID_FILE"))"
        else
            # Wait for whisper service
            echo "  Waiting for Whisper ASR to be ready..."
            for i in $(seq 1 30); do
                if curl -sf --max-time 2 "http://127.0.0.1:9000/docs" > /dev/null 2>&1; then
                    break
                fi
                sleep 1
            done

            nohup python3 "$SCRIPT_DIR/whisper-proxy.py" --port 2022 --whisper-url http://127.0.0.1:9000 \
                > /tmp/whisper-proxy.log 2>&1 &
            echo $! > "$PROXY_PID_FILE"
            sleep 1
            if kill -0 "$(cat "$PROXY_PID_FILE")" 2>/dev/null; then
                ok "Proxy started (PID $(cat "$PROXY_PID_FILE"))"
            else
                fail "Proxy failed to start — check /tmp/whisper-proxy.log"
            fi
        fi
    fi

    start_cpu_fallbacks_verbose

    echo ""
    echo "Starting Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ] && kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
        warn "Piper proxy already running (PID $(cat "$PIPER_PID_FILE"))"
    else
        nohup "$VENV_PY" "$SCRIPT_DIR/piper-proxy.py" --port 8881 \
            --voices-file "$SCRIPT_DIR/voices/piper-voices.json" \
            --models-dir "$SCRIPT_DIR/models/piper" \
            > /tmp/piper-proxy.log 2>&1 &
        echo $! > "$PIPER_PID_FILE"
        sleep 1
        if kill -0 "$(cat "$PIPER_PID_FILE")" 2>/dev/null; then
            ok "Piper proxy started (PID $(cat "$PIPER_PID_FILE"))"
        else
            fail "Piper proxy failed to start — check /tmp/piper-proxy.log"
        fi
    fi

    echo ""
    cmd_status
}

cmd_stop() {
    echo "=== Stopping Local VoiceMode Services ==="

    echo ""
    echo "Stopping proxy..."
    if [ -f "$PROXY_PID_FILE" ]; then
        kill "$(cat "$PROXY_PID_FILE")" 2>/dev/null && ok "Proxy stopped" || warn "Proxy was not running"
        rm -f "$PROXY_PID_FILE"
    else
        warn "No proxy PID file found"
    fi

    echo ""
    echo "Stopping Piper proxy..."
    PIPER_PID_FILE="/tmp/piper-proxy.pid"
    if [ -f "$PIPER_PID_FILE" ]; then
        kill "$(cat "$PIPER_PID_FILE")" 2>/dev/null && ok "Piper proxy stopped" || warn "Piper proxy was not running"
        rm -f "$PIPER_PID_FILE"
    else
        warn "No Piper proxy PID file found"
    fi

    if [ -f /tmp/whisper-server.pid ]; then
        echo ""
        echo "Stopping whisper.cpp server..."
        kill "$(cat /tmp/whisper-server.pid)" 2>/dev/null && ok "whisper.cpp server stopped" || warn "whisper.cpp server was not running"
        rm -f /tmp/whisper-server.pid
    fi

    if [ -f "$FASTER_WHISPER_PID_FILE" ]; then
        echo ""
        echo "Stopping faster-whisper server..."
        kill "$(cat "$FASTER_WHISPER_PID_FILE")" 2>/dev/null && ok "faster-whisper server stopped" || warn "faster-whisper server was not running"
        rm -f "$FASTER_WHISPER_PID_FILE"
    fi

    echo ""
    KOKORO_ONNX_PID_FILE="/tmp/kokoro-onnx-server.pid"
    if [ -f "$KOKORO_ONNX_PID_FILE" ]; then
        echo "Stopping Kokoro ONNX server..."
        kill "$(cat "$KOKORO_ONNX_PID_FILE")" 2>/dev/null && ok "Kokoro ONNX server stopped" || warn "Kokoro ONNX was not running"
        rm -f "$KOKORO_ONNX_PID_FILE"
    fi

    if [ -f "$KOKORO_CPU_PID_FILE" ] || is_kokoro_cpu_fallback; then
        echo ""
        echo "Stopping Kokoro CPU fallback..."
        stop_cpu_fallback "Kokoro CPU fallback" "$KOKORO_CPU_PID_FILE" \
            "$(kokoro_cpu_own_re "$(kokoro_cpu_fallback_port)")"
    fi
    if [ -f "$STT_CPU_PID_FILE" ] || is_stt_cpu_fallback; then
        echo ""
        echo "Stopping faster-whisper CPU fallback..."
        stop_cpu_fallback "faster-whisper CPU fallback" "$STT_CPU_PID_FILE" \
            "$(stt_cpu_own_re "$(stt_cpu_fallback_port)")"
    fi

    echo ""
    echo "Stopping Docker containers..."
    docker_compose_cmd down 2>&1 | sed 's/^/  /'

    ok "All local services stopped"
}

# Endpoint building blocks (priority order matters; OpenAI is always last)
KOKORO_URL="http://127.0.0.1:8880/v1"
PIPER_URL="http://127.0.0.1:8881/v1"
WHISPER_URL="http://127.0.0.1:2022/v1"
OPENAI_URL="https://api.openai.com/v1"

# The CPU fallbacks in the routing (only when configured; otherwise the lists pass unchanged):
#   STT  the fallback URL right after the GPU engine's (2022)
#   TTS  the Kokoro CPU URL after the last Kokoro/Piper URL, i.e. before OpenAI
#        (local: 8880, 8881, 8882), plus VOICEMODE_TTS_TIMEOUT_LOCAL=90 unless already set:
#        CPU Kokoro is 3-4.5x slower than real time, and the default 30 s cuts longer parts.
KOKORO_CPU_FALLBACK_TTS_TIMEOUT=90
stt_urls_with_fallback() {   # $1 = comma list
    local fb="" out="" u
    is_stt_cpu_fallback && fb="http://127.0.0.1:$(stt_cpu_fallback_port)/v1"
    [ -n "$fb" ] || { printf '%s' "$1"; return 0; }
    for u in ${1//,/ }; do
        [ "$u" = "$fb" ] && continue
        out="${out:+$out,}$u"
        [ "$u" = "$WHISPER_URL" ] && out="$out,$fb"
    done
    printf '%s' "$out"
}
tts_urls_with_fallback() {   # $1 = comma list
    local fb="" items=() u i last=-1 out=""
    is_kokoro_cpu_fallback && fb="http://127.0.0.1:$(kokoro_cpu_fallback_port)/v1"
    [ -n "$fb" ] || { printf '%s' "$1"; return 0; }
    for u in ${1//,/ }; do [ "$u" = "$fb" ] || items+=("$u"); done
    for i in "${!items[@]}"; do
        case "${items[$i]}" in "$KOKORO_URL"|"$PIPER_URL") last=$i ;; esac
    done
    [ "$last" -ge 0 ] || { printf '%s' "$1"; return 0; }   # no local Kokoro routed
    for i in "${!items[@]}"; do
        out="${out:+$out,}${items[$i]}"
        [ "$i" -eq "$last" ] && out="$out,$fb"
    done
    printf '%s' "$out"
}
update_env_routed() {   # update_env with the configured CPU fallbacks folded in
    local stt tts timeout=""
    stt="$(stt_urls_with_fallback "$1")"
    tts="$(tts_urls_with_fallback "$2")"
    [ "$tts" != "$2" ] && timeout="$KOKORO_CPU_FALLBACK_TTS_TIMEOUT"
    if [ "$stt" != "$1" ]; then
        echo "  STT CPU fallback: faster-whisper $(stt_cpu_fallback_model) on port $(stt_cpu_fallback_port), after 2022"
    fi
    if [ -n "$timeout" ]; then
        echo "  TTS CPU fallback: Kokoro on port $(kokoro_cpu_fallback_port), after Kokoro and Piper"
    fi
    update_env "$stt" "$tts" "$3" "$4" "$timeout"
}

